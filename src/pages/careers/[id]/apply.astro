---
// Application form for one posting. Only postings that are open (and not
// past their closing date) accept applications; anything else is a 404.
import ApplyPage from '../../../components/ApplyPage.astro';
import { db } from '../../../lib/server/db';
import { getOpenById } from '../../../lib/server/jobs';

export const prerender = false;

const job = await getOpenById(db(Astro.locals), Astro.params.id ?? '');
if (!job) return new Response(null, { status: 404 });
Astro.response.headers.set('Cache-Control', 'public, max-age=60');
---

<ApplyPage job={job} />
