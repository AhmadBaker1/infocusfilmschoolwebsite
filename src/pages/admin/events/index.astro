---
// Events list for marketing: upcoming / past / drafts / archived, with a
// search box and the quick actions that do not need the full editor.
import Admin from '../../../layouts/Admin.astro';
import { db } from '../../../lib/server/db';
import { MODE_LABELS, TABS, listAdmin, tabCounts, whenLabel, type AdminTab } from '../../../lib/server/events';

export const prerender = false;

const d1 = db(Astro.locals);
const q = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 100);
const tabParam = Astro.url.searchParams.get('tab') ?? '';
const tab: AdminTab = (TABS as string[]).includes(tabParam) ? (tabParam as AdminTab) : 'upcoming';

const [events, counts] = await Promise.all([listAdmin(d1, { tab, q }), tabCounts(d1, q)]);

const TAB_LABELS: Record<AdminTab, string> = { upcoming: 'Upcoming', past: 'Past', drafts: 'Drafts', archived: 'Archived' };
const tabHref = (t: AdminTab) => `/admin/events?tab=${t}${q ? `&q=${encodeURIComponent(q)}` : ''}`;
const here = tabHref(tab);
const statusBadge = { draft: 'a-badge--warn', published: 'a-badge--ok', archived: 'a-badge--muted' };
const EMPTY: Record<AdminTab, string> = {
  upcoming: 'Published events that have not happened yet show up here.',
  past: 'Published events that have already happened show up here.',
  drafts: 'Events that are saved but not on the public site yet.',
  archived: 'Events taken off the site but kept for reference.',
};
---

<Admin title="Events" section="events" crumbs={[{ label: 'Dashboard', href: '/admin' }, { label: 'Events' }]}>
  <div slot="actions">
    <a class="a-btn" href="/events" target="_blank" rel="noopener">View public page</a>
    <a class="a-btn a-btn--primary" href="/admin/events/new">+ New event</a>
  </div>

  <ul class="a-tabs">
    {TABS.map((t) => (
      <li>
        <a href={tabHref(t)} aria-current={t === tab ? 'page' : undefined}>
          {TAB_LABELS[t]} <span class="count">{counts[t]}</span>
        </a>
      </li>
    ))}
  </ul>

  <form class="a-toolbar" method="get" action="/admin/events" role="search">
    <input type="hidden" name="tab" value={tab} />
    <input class="a-input" type="search" name="q" value={q} placeholder="Search title, slug or location" aria-label="Search events" />
    <button class="a-btn" type="submit">Search</button>
    {q && <a class="a-btn a-btn--ghost" href={`/admin/events?tab=${tab}`}>Clear</a>}
  </form>

  {events.length === 0 ? (
    <div class="a-empty">
      <strong>{q ? 'No matches' : `No ${tab === 'drafts' ? 'drafts' : `${tab} events`}`}</strong>
      {q ? `Nothing in ${TAB_LABELS[tab].toLowerCase()} matches "${q}".` : EMPTY[tab]}
      <div style="margin-top:16px">
        <a class="a-btn a-btn--primary" href="/admin/events/new">+ New event</a>
      </div>
    </div>
  ) : (
    <section class="a-card a-card--flush">
      <div class="a-table-wrap">
        <table class="a-table">
          <thead>
            <tr>
              <th>Event</th>
              <th>When</th>
              <th>Where</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {events.map((ev) => (
              <tr>
                <td class="primary">
                  {ev.featured ? <span class="star" title="Featured" aria-label="Featured">&#9733;</span> : null}
                  <a href={`/admin/events/${ev.id}`}>{ev.title}</a>
                  <span class="sub">/events/{ev.slug}</span>
                </td>
                <td class="nowrap">{whenLabel(ev)}</td>
                <td>
                  {ev.location || <span class="a-muted">No location</span>}
                  <span class="sub"><span class:list={['a-badge', ev.mode === 'online' ? 'a-badge--blue' : ev.mode === 'hybrid' ? 'a-badge--warn' : '']}>{MODE_LABELS[ev.mode]}</span></span>
                </td>
                <td><span class:list={['a-badge', statusBadge[ev.status]]}>{ev.status}</span></td>
                <td class="actions">
                  <a class="a-btn a-btn--sm" href={`/admin/events/${ev.id}`}>Edit</a>
                  {ev.status === 'published' ? (
                    <form class="a-inline-form" method="post" action={`/api/admin/events/${ev.id}`}>
                      <input type="hidden" name="_action" value="unpublish" />
                      <input type="hidden" name="next" value={here} />
                      <button class="a-btn a-btn--sm" type="submit">Unpublish</button>
                    </form>
                  ) : (
                    <form class="a-inline-form" method="post" action={`/api/admin/events/${ev.id}`}>
                      <input type="hidden" name="_action" value="publish" />
                      <input type="hidden" name="next" value={here} />
                      <button class="a-btn a-btn--sm" type="submit">Publish</button>
                    </form>
                  )}
                  <form class="a-inline-form" method="post" action={`/api/admin/events/${ev.id}`}>
                    <input type="hidden" name="_action" value="duplicate" />
                    <button class="a-btn a-btn--sm a-btn--ghost" type="submit">Duplicate</button>
                  </form>
                  <form class="a-inline-form" method="post" action={`/api/admin/events/${ev.id}`} data-confirm={`Delete "${ev.title}"? This cannot be undone.`}>
                    <input type="hidden" name="_action" value="delete" />
                    <input type="hidden" name="next" value={here} />
                    <button class="a-btn a-btn--sm a-btn--ghost a-btn--danger" type="submit">Delete</button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}
</Admin>

<style>
  .star {
    margin-right: 6px;
    color: var(--a-amber);
  }

  .a-table .actions .a-inline-form {
    margin-left: 6px;
  }
</style>
