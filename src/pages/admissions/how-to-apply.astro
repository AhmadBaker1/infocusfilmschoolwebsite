---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import PageHero from '../../components/PageHero.astro';
import Cta from '../../components/Cta.astro';
import Footer from '../../components/Footer.astro';

const contents = [
  ['step-1', 'Decide on Your Program'],
  ['step-2', 'Complete Application'],
  ['step-3', 'Secure Position'],
  ['wait-list', 'Wait List'],
  ['faq', 'Frequently Asked'],
];

const faqs = [
  {
    q: 'Do I need my own camera equipment?',
    html: `
      <p>No. For the Film Production and Documentary Film programs, you don’t need any of your own camera equipment. Use of InFocus Film School’s professional equipment, including cameras, microphones and other audio gear, lighting, computers and more, is included in the tuition and/or material fee.</p>
      <p>The only items students are asked to provide are media to store their projects (SD cards and a portable hard drive) and consumables, such as tape and the AA batteries some audio equipment needs.</p>`,
  },
  {
    q: 'Do I need my own computer?',
    html: `
      <p><strong>Film Production:</strong> Students should have a laptop or computer to allow editing of projects at home. Computers must be capable of running Adobe CC.</p>
      <p><strong>3D Animation:</strong> If delivered on-site, all computers and required equipment is provided. If your program is being delivered online, you will need to provide a computer and related equipment. The computer should be capable of running Autodesk Maya, ZBrush, and Arnold. Dual monitors and a Wacom tablet is also recommended.</p>
      <p><strong>Writing for Film and Television:</strong> A laptop or tablet capable of word processing is required.</p>
      <p><strong>Documentary Film:</strong> Students should have a laptop or computer to allow editing of projects at home. Computers must be capable of running Adobe CC.</p>
      <p><strong>Visual Effects Compositing:</strong> A computer capable of running the Nuke family of applications is required.</p>
      <p><strong>Graphic and Digital Design:</strong> A computer capable of running Adobe CC is required.</p>
      <p class="faq__links">
        <a href="https://helpx.adobe.com/creative-cloud/system-requirements.html" target="_blank" rel="noopener">System requirements for Adobe CC</a>
        <a href="https://www.foundry.com/products/nuke-family/requirements" target="_blank" rel="noopener">System requirements for Nuke</a>
      </p>`,
  },
  {
    q: 'Does InFocus offer scholarships?',
    html: `
      <p>InFocus Film School offers scholarships to qualified applicants on a case-by-case basis, along with several open scholarship contests each year.</p>
      <p>Limited scholarships may be offered based on merit or financial need. Please <a href="/contact">contact us</a> for more information or to see if you qualify.</p>`,
  },
  {
    q: 'What financial assistance does InFocus provide?',
    html: `
      <p>As a Designated Learning Institution recognized by the provincial and federal governments, InFocus students are eligible for many options that reduce the financial impact of education. This includes grants, bursaries, RESP redemption, and low- or no-interest student loans throughout Canada.</p>
      <p>InFocus also offers interest-free payment plans, scholarships, and other options for students in need of financial assistance. See our <a href="/admissions/finances">Finances page</a>, or <a href="/contact">contact an admissions advisor</a> for more information.</p>`,
  },
  {
    q: 'Does InFocus offer Post-Graduation Work Permits (PGWP)?',
    html: `
      <p>Not at the moment. InFocus programs do not currently qualify graduates for a Post-Graduation Work Permit. If a PGWP is part of your plan, talk to admissions before you apply, and see our <a href="/admissions/international-students">International Students page</a> for what studying here does include.</p>`,
  },
  {
    q: 'Where can I read InFocus student policies?',
    html: `
      <p>You can view all relevant student policies here: <a href="/policies">Policies</a>.</p>
      <p>All policies can also be found in your student enrollment contract.</p>`,
  },
  {
    q: 'What equipment and facilities are available?',
    html: `
      <p>InFocus students have access to professional cameras, lighting, grip, sound and post-production facilities on campus.</p>
      <p><a href="/facilities">Explore our campus and equipment</a>, or <a href="/docs/IFFS_Amenities_Equipment-Services.pdf" target="_blank" rel="noopener">download the full list</a> (PDF).</p>`,
  },
];
---

<Base
  title="How to Apply — InFocus Film School"
  description="How to apply to InFocus Film School: choose your program, complete the application, and secure your position. Application fees, wait list and frequently asked questions."
>
  <Nav />

  <main>
    <PageHero
      title="Applying to InFocus Film School"
      crumbs={[{ label: 'Home', href: '/' }, { label: 'Admissions', href: '/admissions/how-to-apply' }, { label: 'How to Apply' }]}
    >
      <p>
        Three steps from first question to secured seat. Our advisors are available at every
        stage.
      </p>
    </PageHero>

    <div class="page">
      <div class="page__inner">
        <div class="layout">
          <aside class="rail">
            <div class="rail__sticky">
              <h2 class="rail__title">On this page</h2>
              <nav aria-label="Table of contents">
                <ol>
                  {contents.map(([id, label]) => (
                    <li><a href={`#${id}`} data-toc={id}>{label}</a></li>
                  ))}
                </ol>
              </nav>

              <div class="help">
                <h2>Speak to admissions</h2>
                <p>
                  <a href="tel:+16047791145">604-779-1145</a><br />
                  <a href="mailto:admissions@infocusfilmschool.com">admissions@infocusfilmschool.com</a>
                </p>
                <p class="help__addr">554 Seymour Street<br />Vancouver, BC V6B 3J5</p>
              </div>
            </div>
          </aside>

          <article class="body">
            <ol class="steps">
              <li id="step-1" data-section>
                <span class="steps__n" aria-hidden="true">01</span>
                <div class="steps__body">
                  <h2>Decide on Your Program</h2>
                  <p>
                    If you have any questions about our programs, the film industry, or how to
                    achieve your dream job, we would be happy to schedule a one-on-one info session
                    with a career advisor. Sessions can be held in person or virtually.
                  </p>
                  <a class="act" href="/contact">
                    Contact us to schedule your free info session<span class="arw arw--r" aria-hidden="true"></span>
                  </a>
                </div>
              </li>

              <li id="step-2" data-section>
                <span class="steps__n" aria-hidden="true">02</span>
                <div class="steps__body">
                  <h2>Complete Application</h2>
                  <p>
                    Complete the application form and pay the application fee. If you need
                    assistance, email
                    <a href="mailto:admissions@infocusfilmschool.com">admissions@infocusfilmschool.com</a>,
                    or call <a href="tel:+16047791145">604-779-1145</a>.
                  </p>

                  <dl class="fees">
                    <div>
                      <dt>Domestic students</dt>
                      <dd>$150 application fee</dd>
                    </div>
                    <div>
                      <dt>International students</dt>
                      <dd>$250 application fee</dd>
                    </div>
                  </dl>

                  <p>
                    Payment can be made by Credit Card or PayPal when completing the application
                    form.
                  </p>
                  <a class="act ph" href="#">Application form<span class="arw arw--r" aria-hidden="true"></span></a>
                </div>
              </li>

              <li id="step-3" data-section>
                <span class="steps__n" aria-hidden="true">03</span>
                <div class="steps__body">
                  <h2>Secure Position</h2>
                  <p>
                    Upon acceptance into the program, you will be asked to submit any additional
                    required documents, complete an enrolment contract, and provide a deposit to
                    secure your enrollment.
                  </p>
                  <p>
                    InFocus works closely with consultants able to assist international students
                    with their study permit applications.
                  </p>
                  <p>
                    For most programs, we normally require all tuition and related fees to be paid
                    before the end of your first term of study. If our standard payment schedule is
                    of concern, we will work with you to establish a payment plan that fits your
                    financial situation.
                  </p>
                  <a class="act" href="/admissions/international-students">
                    International student information<span class="arw arw--r" aria-hidden="true"></span>
                  </a>
                </div>
              </li>
            </ol>

            <section id="wait-list" class="plain" data-section>
              <h2>Wait List</h2>
              <p>If your desired intake is full, you will be placed on the wait list.</p>
            </section>

            <section id="faq" class="plain" data-section>
              <h2>Frequently Asked</h2>
              <div class="faq">
                {
                  faqs.map((f, i) => (
                    <div class="qa" data-qa>
                      <button class="qa__q" type="button" id={`qa-${i}-btn`}
                              aria-expanded="false" aria-controls={`qa-${i}`}>
                        <span class="qa__text">{f.q}</span>
                        <span class="qa__icon" aria-hidden="true" />
                      </button>
                      <div class="qa__panel" id={`qa-${i}`} role="region" aria-labelledby={`qa-${i}-btn`}>
                        <div class="qa__inner" set:html={f.html} />
                      </div>
                    </div>
                  ))
                }
              </div>
            </section>
          </article>
        </div>
      </div>
    </div>
  </main>

  <Cta />
  <Footer />
</Base>

<style>

  /* ---- Layout ---- */

  .page {
    background: var(--white);
    color: var(--charcoal);
    padding: clamp(38px, 4.6vw, 76px) var(--gutter) clamp(56px, 7vw, 110px);
  }

  .page__inner {
    max-width: 1320px;
    margin: 0 auto;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 250px) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 90px);
    align-items: start;
  }

  .rail__sticky {
    position: sticky;
    top: calc(var(--nav-h) + 28px);
  }

  .rail__title {
    margin: 0 0 14px;
    font-family: var(--font-head);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8a8a8a;
  }

  .rail ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid rgba(51, 51, 51, 0.18);
  }

  .rail ol a {
    display: block;
    padding: 7px 0 7px 14px;
    margin-left: -1px;
    border-left: 2px solid transparent;
    font-size: 14px;
    line-height: 1.35;
    color: #5c5c5c;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .rail ol a:hover {
    color: var(--charcoal);
  }

  .rail ol a[aria-current='true'] {
    border-left-color: var(--red);
    color: var(--charcoal);
    font-weight: 600;
  }

  /* Contact block — the thing applicants actually need to hand. */
  .help {
    margin-top: clamp(24px, 3vw, 38px);
    padding-top: clamp(18px, 2vw, 26px);
    border-top: 2px solid var(--charcoal);
  }

  .help h2 {
    margin: 0 0 10px;
    font-family: var(--font-head);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8a8a8a;
  }

  .help p {
    margin: 0 0 10px;
    font-size: 14px;
    line-height: 1.6;
    color: #3f3f3f;
  }

  .help a {
    color: var(--charcoal);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(189, 47, 47, 0.55);
  }

  .help a:hover {
    color: var(--red);
  }

  .help__addr {
    color: #6d6d6d;
  }

  /* ---- Steps ---- */

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps > li {
    position: relative;
    display: grid;
    grid-template-columns: clamp(56px, 6vw, 84px) minmax(0, 1fr);
    gap: clamp(16px, 2vw, 34px);
    padding-bottom: clamp(30px, 3.6vw, 54px);
  }

  /* Rail connecting the step markers. */
  .steps > li::before {
    content: '';
    position: absolute;
    top: clamp(34px, 3.4vw, 46px);
    bottom: 0;
    left: clamp(27px, 3vw, 41px);
    width: 1px;
    background: rgba(51, 51, 51, 0.2);
  }

  .steps > li:last-child::before {
    display: none;
  }

  .steps__n {
    display: grid;
    place-items: center;
    width: clamp(56px, 6vw, 84px);
    height: clamp(56px, 6vw, 84px);
    border: 2px solid var(--red);
    border-radius: 50%;
    background: var(--white);
    font-family: var(--font-head);
    font-size: clamp(17px, 1.6vw, 27px);
    font-weight: 600;
    color: var(--red);
  }

  .steps h2 {
    margin: 0 0 clamp(10px, 1.2vw, 16px);
    scroll-margin-top: calc(var(--nav-h) + 24px);
    font-size: clamp(21px, 2vw, 33px);
    font-weight: 600;
    line-height: 1.12;
    /* Optically centres the title against the marker. */
    padding-top: clamp(10px, 1.2vw, 20px);
  }

  .body p {
    margin: 0 0 1.05em;
    max-width: 70ch;
    font-size: clamp(15px, 1.05vw, 17px);
    line-height: 1.7;
    color: #3f3f3f;
  }

  .body a {
    color: var(--charcoal);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(189, 47, 47, 0.55);
    transition: color 0.2s ease;
  }

  .body a:hover {
    color: var(--red);
  }

  .act {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 4px;
    font-family: var(--font-head);
    font-size: clamp(12px, 0.88vw, 15px);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none !important;
  }

  .act span {
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .act:hover span {
    transform: translateX(5px);
  }

  /* ---- Fees ---- */

  .fees {
    margin: 0 0 1.3em;
    max-width: 460px;
    border-top: 1px solid rgba(51, 51, 51, 0.2);
  }

  .fees > div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px;
    padding: 11px 0;
    border-bottom: 1px solid rgba(51, 51, 51, 0.12);
  }

  .fees dt {
    font-size: clamp(14px, 1vw, 16px);
    color: #3f3f3f;
  }

  .fees dd {
    margin: 0;
    font-family: var(--font-head);
    font-size: clamp(14px, 1vw, 17px);
    font-weight: 500;
    color: var(--charcoal);
  }

  /* ---- Plain sections ---- */

  .plain {
    margin-top: clamp(28px, 3.4vw, 50px);
    padding-top: clamp(26px, 3.2vw, 46px);
    border-top: 1px solid rgba(51, 51, 51, 0.16);
  }

  .plain h2 {
    margin: 0 0 clamp(12px, 1.4vw, 20px);
    scroll-margin-top: calc(var(--nav-h) + 24px);
    font-size: clamp(21px, 2vw, 33px);
    font-weight: 600;
    line-height: 1.12;
  }

  /* ---- FAQ ---- */

  .faq {
    border-top: 1px solid rgba(51, 51, 51, 0.16);
  }

  .qa {
    border-bottom: 1px solid rgba(51, 51, 51, 0.16);
  }

  .qa__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    padding: clamp(14px, 1.5vw, 20px) 0;
    text-align: left;
    cursor: pointer;
  }

  .qa__text {
    font-family: var(--font-head);
    font-size: clamp(15px, 1.2vw, 21px);
    font-weight: 500;
    line-height: 1.2;
    transition: color 0.25s ease;
  }

  .qa__q:hover .qa__text {
    color: var(--red);
  }

  /* Two bars that rotate into a minus — always aligned. */
  .qa__icon {
    position: relative;
    flex: none;
    width: 15px;
    height: 15px;
  }

  .qa__icon::before,
  .qa__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 15px;
    height: 2px;
    margin-top: -1px;
    background: var(--red);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .qa__icon::after {
    transform: rotate(90deg);
  }

  .qa.is-open .qa__icon::after {
    transform: rotate(0deg);
  }

  /* 0fr -> 1fr eases to the answer's true height, which max-height cannot. */
  .qa__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.42s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .qa.is-open .qa__panel {
    grid-template-rows: 1fr;
  }

  .qa__inner {
    overflow: hidden;
  }

  .qa__inner :global(p) {
    margin: 0 0 0.9em;
    max-width: 70ch;
    font-size: clamp(14px, 1vw, 16px);
    line-height: 1.65;
    color: #3f3f3f;
  }

  .qa__inner :global(p:last-child) {
    margin-bottom: clamp(16px, 1.8vw, 24px);
  }

  .qa__inner :global(strong) {
    color: var(--charcoal);
    font-weight: 600;
  }

  .qa__inner :global(a) {
    color: var(--charcoal);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(189, 47, 47, 0.55);
  }

  .qa__inner :global(a:hover) {
    color: var(--red);
  }

  .qa__inner :global(.faq__links) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 26px;
  }

  /* Destination not supplied yet. */
  :global(.ph) {
    opacity: 0.5;
    text-decoration: underline dotted !important;
    cursor: not-allowed;
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .rail__sticky {
      position: static;
    }

    .rail ol {
      column-count: 2;
      column-gap: 24px;
    }
  }

  @media (max-width: 560px) {
    .rail ol {
      column-count: 1;
    }

    .steps > li {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }

    .steps > li::before {
      display: none;
    }

    .steps h2 {
      padding-top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qa__panel,
    .qa__icon::before,
    .qa__icon::after,
    .act span {
      transition: none;
    }
  }
</style>

<script>
  // Accordion. Buttons + panels rather than <details>, which cannot animate
  // shut because the browser hides its content as soon as `open` is removed.
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-qa]'));

  for (const item of items) {
    const btn = item.querySelector<HTMLButtonElement>('.qa__q');
    if (!btn) continue;

    btn.addEventListener('click', () => {
      const open = item.classList.contains('is-open');
      for (const other of items) {
        other.classList.remove('is-open');
        other.querySelector('.qa__q')?.setAttribute('aria-expanded', 'false');
      }
      if (!open) {
        item.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  }

  // Marks the contents entry for whichever section is in view.
  const links = new Map<string, HTMLAnchorElement>();
  for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-toc]')) {
    links.set(a.dataset.toc!, a);
  }

  const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-section]'));

  if (sections.length && links.size && window.IntersectionObserver) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          for (const a of links.values()) a.removeAttribute('aria-current');
          links.get(entry.target.id)?.setAttribute('aria-current', 'true');
        }
      },
      { rootMargin: '-20% 0px -70% 0px' }
    );
    for (const s of sections) io.observe(s);
  }
</script>
