---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import PageHero from '../../components/PageHero.astro';
import Cta from '../../components/Cta.astro';
import Footer from '../../components/Footer.astro';

const contents = [
  ['orientation', 'Orientation'],
  ['getting-started', 'Getting Started'],
  ['arriving', 'Arriving in Canada'],
  ['medical-insurance', 'Medical Insurance'],
  ['what-to-expect', 'What to Expect'],
  ['learning-supports', 'Learning Supports'],
  ['community-supports', 'Community Supports'],
  ['pathways', 'Pathways'],
];

const GUIDE_URL = '/docs/IFFS_Student-Orientation_2526-1.pdf';

const IRCC_FUNDS =
  'https://www.canada.ca/en/immigration-refugees-citizenship/services/study-canada/study-permit/get-documents/financial-support.html';
const TRV_CHECK =
  'https://www.canada.ca/en/immigration-refugees-citizenship/services/visit-canada/check-visa-eta.html';

// Checked against IRCC on 2026-09-24 (single applicant, outside Quebec).
// IRCC revises this every year; update it when they do.
const FUNDS_MIN = '$23,448';

const funding = [
  'Proof of a Canadian bank account in your name, if you’ve transferred money to Canada',
  'A Guaranteed Investment Certificate (GIC) from a participating Canadian financial institution',
  'Proof of a student or education loan from a bank',
  'Your bank statements for the past 4 months',
  'A bank draft that can be converted to Canadian dollars',
  'Proof you paid tuition and housing fees',
  'A letter from the person giving you money, such as a parent’s or grandparent’s bank statement and letter of financial support',
];

const progress = [
  'Complete all class assignments',
  'Hand in homework and deliverables on schedule',
  'Participate in group projects',
  'Maintain regular attendance',
  'Ask your Instructor or Program Manager for help if you are struggling',
];

const POLICIES_URL: string | null = '/policies';
const policies = [
  'Student Statement of Rights',
  'Tuition Refund Policy',
  'English Proficiency Policy',
  'Accessibility Policy',
  'Grade Appeal Policy',
  'Attendance Policy',
  'Student Code of Conduct',
  'Discipline & Dismissal Policy',
  'Dispute Resolution Policy',
  'Harassment, Violence & Sexual Misconduct Policy',
  'Critical Incident & Crisis Policy',
];

const supports = [
  {
    title: 'Access to instructors',
    text: 'Our instructors are experienced industry professionals who are passionate about teaching. Connect with them during class, after class or online to ask questions, get feedback and explore creative ideas.',
  },
  {
    title: 'One-on-one tutoring',
    text: 'Need extra help with a scene, script or edit? Tutoring gives you focused attention and personalized advice so you can build skills and confidence at your own pace.',
  },
  {
    title: 'Assisted lab sessions',
    text: 'During lab sessions, our teaching assistants help troubleshoot technical issues, guide you through complex tasks and offer practical tips drawn from real experience.',
  },
  {
    title: 'After-hours facility access',
    text: 'Creativity doesn’t keep office hours. Our computer labs and campus facilities stay open after hours so you can work on projects, practise techniques and make the most of professional equipment.',
  },
  {
    title: 'Gear library',
    text: 'Sign out cameras, lighting, audio equipment and other filmmaking tools to work on projects outside of class, and sharpen your skills with professional gear in your own time.',
  },
  {
    title: 'Accessibility accommodations',
    text: 'If you have a disability or learning difference, we can arrange accommodations so you can participate fully in classes and projects. Our team works with you to understand your needs and provide the right support.',
  },
];

const community = [
  {
    title: 'Daily life in BC',
    text: 'Practical information for everyday life, from housing and transportation to healthcare, banking and more, so you know what to expect and can settle in with ease.',
    link: 'WelcomeBC: Daily Life',
    url: 'https://www.welcomebc.ca/start-your-life-in-b-c/living-in-bc',
  },
  {
    title: 'Indigenous Peoples of British Columbia',
    text: 'Learn about the rich cultures, histories and contributions of the First Peoples of this land. An essential resource for respectful living and learning.',
    link: 'WelcomeBC: Indigenous Peoples in BC',
    url: 'https://www.welcomebc.ca/choose-b-c/about-british-columbia-canada',
  },
  {
    title: 'Canadian culture and systems',
    text: 'Adjusting to a new country takes time. This resource explains workplace norms, government systems and social values in BC and Canada, so you feel more connected to your new home.',
    link: 'WelcomeBC: Culture and Systems',
    url: 'https://www.welcomebc.ca/choose-b-c/about-british-columbia-canada',
  },
  {
    title: 'Services for 2SLGBTQIA+ newcomers and refugees',
    text: 'MOSAIC offers a welcoming, affirming space with support programs, peer connections and legal guidance to help you feel safe, seen and supported as you build a new life in Canada.',
    link: 'MOSAIC BC',
    url: 'https://mosaicbc.org/our-programs/services-for-newcomer-lqbtq-refugees/',
  },
  {
    title: 'Indigenous students coming to Vancouver',
    text: 'VAFCS supports Indigenous youth and students with cultural programming, community services and a sense of belonging in the heart of Vancouver.',
    link: 'Vancouver Aboriginal Friendship Centre Society',
    url: 'https://vafcs.org/',
  },
];

const living = [
  ['Housing', '/admissions/housing#housing'],
  ['Cost of Living', '/admissions/housing#cost-of-living'],
  ['Tenancy Rights', '/admissions/housing#tenancy-rights'],
  ['Employment Rights', '/admissions/housing#employment-rights'],
];
---

<Base
  title="International Students — InFocus Film School"
  description="Studying at InFocus Film School as an international student: study permits, visas, arriving in Canada, medical insurance, supports and pathways."
>
  <Nav />

  <main>
    <PageHero
      title="International Students"
      crumbs={[{ label: 'Home', href: '/' }, { label: 'Admissions', href: '/admissions/how-to-apply' }, { label: 'International Students' }]}
    >
      <p>
        InFocus Film School welcomes a very diverse student body. As a Designated Learning
        Institution (DLI) recognized by Immigration, Refugees and Citizenship Canada, we accept
        international students, and every class brings together domestic and international
        students from around the world. We strive to make studying abroad as simple and enjoyable
        as possible.
      </p>
    </PageHero>

    <div class="page">
      <div class="page__inner">
        <div class="layout">
          <aside class="toc">
            <h2 class="toc__title">On this page</h2>
            <nav aria-label="Table of contents">
              <ol>
                {contents.map(([id, label]) => (
                  <li><a href={`#${id}`} data-toc={id}>{label}</a></li>
                ))}
              </ol>
            </nav>
          </aside>

          <article class="body">
            <section id="orientation" data-section>
              <h2>Orientation</h2>
              <p class="note">
                This information should not be considered legal immigration advice. We have
                compiled a few important things to know for students looking to study in Canada.
              </p>

              <div class="orient">
                <div class="orient__copy">
                  <span class="orient__label">2025/26</span>
                  <p class="orient__date">Student Orientation Guide</p>
                  <p class="orient__text">
                    International students are invited to an online orientation session ahead of
                    the Fall term. Watch your inbox for your orientation date, and read the
                    orientation guide before you arrive.
                  </p>
                  <div class="orient__actions">
                    <a class="orient__btn" href={GUIDE_URL} download>
                      Download the guide <span aria-hidden="true">↓</span>
                    </a>
                    <a class="orient__view" href={GUIDE_URL} target="_blank" rel="noopener">
                      View online <span aria-hidden="true">↗</span>
                    </a>
                  </div>
                  <span class="orient__meta">PDF · 10 pages · 15 MB</span>
                </div>

                {/* First three pages fanned like a deck; they spread on hover. */}
                <a class="deck" href={GUIDE_URL} target="_blank" rel="noopener" aria-label="Open the 2025/26 Student Orientation Guide (PDF)">
                  <img class="deck__page deck__page--3" src="/images/orientation-p3.jpg" alt="" width="1200" height="675" loading="lazy" decoding="async" />
                  <img class="deck__page deck__page--2" src="/images/orientation-p2.jpg" alt="" width="1200" height="675" loading="lazy" decoding="async" />
                  <img class="deck__page deck__page--1" src="/images/orientation-cover.jpg" alt="" width="1200" height="675" loading="lazy" decoding="async" />
                  <span class="deck__tag">2025/26 Guide</span>
                </a>
              </div>
            </section>

            <section id="getting-started" data-section>
              <h2>Getting Started</h2>

              <h3 class="sub">Language proficiency</h3>
              <p>
                All classes at InFocus Film School are taught in English. If English is not your
                primary language, you may be required to provide proof of English proficiency by
                completing a recognized English language proficiency exam. You may have other
                options if you haven’t completed an exam, so <a href="/contact">contact us</a>
                for more details.
              </p>
              <p><a href="/policies#english-proficiency-policy">View our English Proficiency Policy</a></p>

              <h3 class="sub">Study permits</h3>
              <p>
                International students need a study permit for programs longer than 6 months.
                Study permits are issued by Immigration, Refugees and Citizenship Canada (IRCC),
                and InFocus may be able to offer resources to help with your application. If visas
                can be difficult to obtain from your country, we highly recommend working with an
                accredited immigration consultant or lawyer before you apply.
              </p>
              <p>
                <a href="https://www.canada.ca/en/immigration-refugees-citizenship/services/study-canada/study-permit.html" target="_blank" rel="noopener">More information on study permits</a>
              </p>

              <h3 class="sub">Visa requirements</h3>
              <p>
                Citizens of certain countries and territories need a Temporary Resident Visa (TRV)
                to visit Canada. <a href={TRV_CHECK} target="_blank" rel="noopener">Find out if you
                need a TRV</a>. Again, we highly recommend working with an accredited immigration
                consultant or lawyer before applying for your visa.
              </p>
              <p>
                If you’re travelling to Canada from a country where you don’t hold citizenship, you
                may need additional documents. Check with an immigration agent or consular
                official before you leave.
              </p>
            </section>

            <section id="arriving" data-section>
              <h2>Arriving in Canada</h2>
              <p>
                Before you depart, make sure you have all the documents you need to enter Canada.
                This list may not be complete, so check with a consular official before you leave.
              </p>

              <ol class="docs">
                <li class="doc">
                  <span class="doc__n" aria-hidden="true">01</span>
                  <div>
                    <h3 class="doc__title">A valid passport</h3>
                    <p>
                      Your passport must be valid for your entire stay in Canada. Check the
                      expiry date and leave enough time to renew your travel documents if needed.
                    </p>
                  </div>
                </li>
                <li class="doc">
                  <span class="doc__n" aria-hidden="true">02</span>
                  <div>
                    <h3 class="doc__title">Your InFocus acceptance letter</h3>
                    <p>
                      You’ll need to present the original acceptance letter you received from
                      InFocus Film School.
                    </p>
                  </div>
                </li>
                <li class="doc">
                  <span class="doc__n" aria-hidden="true">03</span>
                  <div>
                    <h3 class="doc__title">Proof of financial support</h3>
                    <p>
                      IRCC requires proof of at least <strong>{FUNDS_MIN} CAD</strong> to cover
                      living expenses for your first year in Canada, in addition to your first
                      year’s tuition and travel costs.
                      <a href={IRCC_FUNDS} target="_blank" rel="noopener">See IRCC’s current amounts</a>.
                    </p>
                    <p class="doc__lead">Examples of financial support:</p>
                    <ul class="list">
                      {funding.map((f) => <li>{f}</li>)}
                    </ul>
                  </div>
                </li>
                <li class="doc">
                  <span class="doc__n" aria-hidden="true">04</span>
                  <div>
                    <h3 class="doc__title">Your Temporary Resident Visa (TRV)</h3>
                    <p>
                      A TRV is a document placed in your passport that allows you to enter Canada.
                      If you’re from a country that requires a visa, you’ll need a TRV in addition
                      to your study permit. <a href={TRV_CHECK} target="_blank" rel="noopener">Find
                      out if you need a TRV</a>.
                    </p>
                    <dl class="pair">
                      <div>
                        <dt>TRV</dt>
                        <dd>Lets you enter Canada</dd>
                      </div>
                      <div>
                        <dt>Study permit</dt>
                        <dd>Lets you study and stay in Canada</dd>
                      </div>
                    </dl>
                    <p>
                      You need a valid TRV each time you enter Canada, so keep it up to date if you
                      plan to travel during your studies.
                    </p>
                  </div>
                </li>
                <li class="doc">
                  <span class="doc__n" aria-hidden="true">05</span>
                  <div>
                    <h3 class="doc__title">Your Port of Entry (POE) letter</h3>
                    <p>
                      This letter shows you’ve been approved for a study permit, and allows border
                      officers to issue it to you when you arrive.
                      <a href="https://ircc.canada.ca/english/helpcentre/answer.asp?qnum=845&top=15" target="_blank" rel="noopener">Learn more</a>.
                    </p>
                  </div>
                </li>
              </ol>
            </section>

            <section id="medical-insurance" data-section>
              <h2>Medical Insurance</h2>
              <p>
                All international students should have their own medical insurance while studying
                in Canada. Make sure you’re privately covered for your first three months in
                British Columbia. After three months living in BC, you can qualify for BC’s Medical
                Services Plan (MSP).
              </p>
              <p class="alert">
                Students must have medical insurance while studying at InFocus, or you will not be
                eligible for services from us.
              </p>

              <h3 class="sub">How insurance works</h3>
              <div class="split">
                <div class="split__card">
                  <span class="split__tag">International students</span>
                  <p>
                    All international students must have medical insurance for the length of their
                    studies at InFocus. We’ve partnered with
                    <a href="https://www.guard.me/" target="_blank" rel="noopener">guard.me</a>, a
                    Canadian insurance provider offering coverage to international students at
                    affordable rates, estimated at $2.00 CAD per day. Guard.me covers you from the
                    time you leave home (up to seven days before arrival) until a week after your
                    program end date. InFocus does not accept insurance from companies outside of
                    Canada.
                  </p>
                </div>
                <div class="split__card">
                  <span class="split__tag">Canadian students</span>
                  <p>
                    Canadian students can stay on their home province’s medical plan. You must
                    notify your provincial health provider that you’ll be away from home studying
                    at a post-secondary school in BC.
                  </p>
                </div>
              </div>

              <h3 class="sub">Living in BC for 3 months or more</h3>
              <p>
                Enrol in MSP as soon as you arrive in Canada. Coverage usually starts three months
                after your arrival date, and students who have lived in BC for more than three
                months are eligible.
              </p>
              <p>
                <a href="https://www2.gov.bc.ca/gov/content/health/health-drug-coverage/msp/bc-residents/eligibility-and-enrolment/how-to-enrol" target="_blank" rel="noopener">Apply for MSP</a>
              </p>
            </section>

            <section id="what-to-expect" data-section>
              <h2>What to Expect</h2>

              <h3 class="sub">Attendance requirements</h3>
              <div class="stat">
                <span class="stat__figure">85–90%</span>
                <span class="stat__text">Typical minimum attendance per course. Your Course Outline lists the exact requirement.</span>
              </div>
              <p>
                Regular attendance is expected. Many of our programs are built around
                collaboration, peer feedback and group projects, so your presence and participation
                make the learning experience better for everyone. Every course has a minimum
                attendance requirement to make sure students receive enough guidance and
                instruction to meet the program’s learning objectives.
              </p>
              <p>
                There are also minimum attendance hours to be eligible for a certificate or
                diploma. You’ll find these on the Program Outline in your student enrolment
                contract, under “Completion Requirements”.
              </p>
              <p>
                For on-campus programs, attendance is taken at the beginning of class and again
                after the break. Students not present for the attendance call are marked absent.
                Chronic absence or lateness may result in penalties; see the Attendance Policy for
                full details.
              </p>
              <p>
                Keep track of your own attendance and any absences, and let the school know in
                advance whenever possible. In an emergency, notify the school as soon as you can.
              </p>

              <h3 class="sub">Academic progression requirements</h3>
              <p>
                Students are expected to make reasonable academic progress, which means keeping up
                with in-class work, homework and projects. To stay on track, we encourage you to:
              </p>
              <ul class="checks">
                {progress.map((p) => <li>{p}</li>)}
              </ul>
              <p>
                Not all courses are offered every term, so failing a course can significantly delay
                your program completion. Support outside class time can be arranged for students
                who need extra help.
              </p>

              <h3 class="sub">School policies</h3>
              <p>InFocus Film School has several policies in place to support the student experience:</p>
              <ul class="policies">
                {policies.map((p) => <li>{p}</li>)}
              </ul>
              <p>
                {POLICIES_URL ? (
                  <a href={POLICIES_URL}>Read all school policies</a>
                ) : (
                  <a class="ph" href="#">Read all school policies</a>
                )}
              </p>

              <h3 class="sub">School amenities</h3>
              <p>
                InFocus Film School facilities are clean, modern and have everything you need to
                get started.
              </p>
              <p>
                <a href="/facilities">Explore our campus and equipment</a>
              </p>
            </section>

            <section id="learning-supports" data-section>
              <h2>Learning Supports</h2>
              <p>
                At InFocus Film School, your success is our focus. Whether you’re crafting your
                first short film or refining your skills for the big screen, we make sure you have
                the guidance, tools and time you need to excel. To access learning supports,
                contact Student Services.
              </p>
              <ul class="supports">
                {supports.map((s, i) => (
                  <li class="support">
                    <span class="support__n">{String(i + 1).padStart(2, '0')}</span>
                    <h3 class="support__title">{s.title}</h3>
                    <p>{s.text}</p>
                  </li>
                ))}
              </ul>
            </section>

            <section id="community-supports" data-section>
              <h2>Community Integration Supports</h2>
              <p>
                Start your journey in British Columbia, where world-class education meets vibrant
                culture, stunning natural beauty and inclusive communities. Whether you’re
                exploring new academic pathways or discovering life in Canada, BC is a place to
                grow, connect and thrive.
              </p>
              <ul class="resources">
                {community.map((c) => (
                  <li class="resource">
                    <h3 class="resource__title">{c.title}</h3>
                    <p>{c.text}</p>
                    <a class="resource__link" href={c.url} target="_blank" rel="noopener">
                      {c.link} <span aria-hidden="true">↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>

            <section id="pathways" data-section>
              <h2>Pathways</h2>

              <h3 class="sub">Post-Graduation Work Permits</h3>
              <p>
                At the moment, InFocus graduates do not earn a Post-Graduation Work Permit
                (PGWP): our programs are not eligible for the PGWP Program. If a PGWP or another
                way to work in Canada after your studies is part of your plan, we recommend
                consulting a certified immigration consultant to explore your options.
              </p>
              <p>
                <a href="https://www.canada.ca/en/immigration-refugees-citizenship/services/study-canada/work/after-graduation/about.html" target="_blank" rel="noopener">More information on the PGWP</a>
              </p>

              <a class="yorkville" href="/#partnership">
                <span class="yorkville__logo">
                  <img src="/images/logo-yorkville.jpg" alt="Yorkville University" loading="lazy" decoding="async" />
                </span>
                <span class="yorkville__body">
                  <span class="yorkville__tag">Yorkville University Pathway</span>
                  <span class="yorkville__title">A bachelor’s degree in as little as 15 months</span>
                  <span class="yorkville__text">
                    Graduates of our Film Production Program are eligible for placement into a
                    pathway with Yorkville University to earn a Bachelor of Creative Arts in as
                    little as 15 months.
                  </span>
                  <span class="yorkville__cta">Learn more <span aria-hidden="true">→</span></span>
                </span>
                <span class="yorkville__stat" aria-hidden="true">
                  <strong>15</strong>
                  <span>months</span>
                </span>
              </a>
            </section>
          </article>
        </div>
      </div>
    </div>

    <!-- Hand-off to the housing page for students already here. -->
    <section class="local" aria-labelledby="local-title">
      <span class="local__corner local__corner--tl" aria-hidden="true"></span>
      <span class="local__corner local__corner--tr" aria-hidden="true"></span>
      <span class="local__corner local__corner--bl" aria-hidden="true"></span>
      <span class="local__corner local__corner--br" aria-hidden="true"></span>

