  }

  .yorkville__stat span {
    font-size: 12px;
    letter-spacing: 0.18em;
    color: #6d6d6d;
  }

  /* ---- Already living in Vancouver ---- */

  .local {
    --inset: clamp(14px, 1.8vw, 30px);
    position: relative;
    overflow: hidden;
    isolation: isolate;
    --art-w: max(100vw, 820px);
    /* The copy clears the tallest tower, whose tip is ~15% down the art. */
    padding: clamp(64px, 8vw, 130px) var(--gutter) calc(var(--art-w) * 0.2225 * 0.86 + 24px);
    background:
      /* Blue kept up top so the skyline sits on flat charcoal, matching the
         buildings' fill. */
      radial-gradient(60% 90% at 0% 0%, rgba(34, 68, 102, 0.5), transparent 70%),
      var(--charcoal);
    color: var(--white);
  }

  /* Scales by width only, so nothing is cropped. On narrow screens it keeps
     a minimum width (centred, sides trimmed) so the detail stays legible. */
  .local__art {
    position: absolute;
    left: 50%;
    bottom: 0;
    z-index: -1;
    width: var(--art-w);
    height: auto;
    transform: translateX(-50%);
    overflow: visible;
  }

  .local__sun {
    fill: var(--red);
  }

  .local__ridge {
    fill: none;
    stroke: rgba(255, 255, 255, 0.3);
    stroke-width: 1.2;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .local__ridge--far {
    stroke: rgba(255, 255, 255, 0.14);
  }

  /* Solid fill so the towers stand as silhouettes against the ridges and
     the sunset glow behind them. */
  .local__city {
    fill: var(--charcoal);
    stroke: rgba(255, 255, 255, 0.55);
    stroke-width: 1.1;
    stroke-linejoin: round;
  }

  .local__city :global(*) {
    vector-effect: non-scaling-stroke;
  }

  .local__city .open {
    fill: none;
  }

  .local__city .win {
    fill: url(#local-win);
    stroke: none;
  }

  #local-win rect {
    fill: rgba(255, 255, 255, 0.16);
  }

  .local__water {
    stroke: rgba(255, 255, 255, 0.5);
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
  }

  .local__ripple {
    stroke: rgba(255, 255, 255, 0.16);
    vector-effect: non-scaling-stroke;
  }

  .local__corner {
    position: absolute;
    width: clamp(18px, 1.8vw, 30px);
    aspect-ratio: 1;
    border: 0 solid rgba(255, 255, 255, 0.5);
  }

  .local__corner--tl { top: var(--inset); left: var(--inset); border-top-width: 2px; border-left-width: 2px; }
