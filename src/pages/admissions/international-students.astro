  .deck__page--2 {
    transform: translate(4.5%, -3.5%) rotate(2.5deg) scale(0.97);
    filter: brightness(0.85);
  }

  .deck:hover .deck__page--3 {
    transform: translate(16%, -12%) rotate(9deg) scale(0.94);
  }

  .deck:hover .deck__page--2 {
    transform: translate(8%, -6%) rotate(4.5deg) scale(0.97);
  }

  .deck:hover .deck__page--1 {
    transform: translate(-2%, 1%) rotate(-1.5deg);
    box-shadow: 0 28px 60px -20px rgba(0, 0, 0, 0.75);
