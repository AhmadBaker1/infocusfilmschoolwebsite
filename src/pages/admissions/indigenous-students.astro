---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import PageHero from '../../components/PageHero.astro';
import Cta from '../../components/Cta.astro';
import Footer from '../../components/Footer.astro';

const contents = [
  ['funding', 'Funding Your Education'],
  ['band-funding', 'Band Funding'],
  ['scholarships', 'Scholarships + Other Funding'],
  ['reconciliation', 'Truth and Reconciliation'],
];

const programs = ['Film Production', 'Screenwriting', '3D Animation', 'Visual Effects', 'Documentary', 'Graphic Design'];

// Links checked 2026-09-24. Irving K. Barber is now the BC Scholarship
// Society; its old bcscholarship.ca domain no longer belongs to it.
const resources = [
  { name: 'Congress of Aboriginal Peoples', url: 'https://abo-peoples.org/' },
  { name: 'Future Generations Foundation', url: 'https://fgfoundation.ca/programs/individual-funding/' },
  { name: 'First Peoples’ Cultural Council', url: 'https://fpcc.ca/' },
  { name: 'BC Association of Aboriginal Friendship Centres', url: 'https://bcaafc.com/' },
  { name: 'BC Scholarship Society (Irving K. Barber)', url: 'https://www.ikbbc.ca/' },
  { name: 'Indspire Bursaries and Scholarships', url: 'https://indspire.ca/for-students/bursaries-scholarships/' },
  { name: 'New Relationship Trust', url: 'https://www.newrelationshiptrust.ca/' },
];

const nations = [
  { name: 'xʷməθkʷəy̓əm', en: 'Musqueam', url: 'https://www.musqueam.bc.ca/' },
  { name: 'Sḵwx̱wú7mesh', en: 'Squamish', url: 'https://www.squamish.net/' },
  { name: 'səl̓ílwətaɬ', en: 'Tsleil-Waututh', url: 'https://twnation.ca/' },
];
---

<Base
  title="Indigenous Students — InFocus Film School"
  description="Funding for First Nations, Métis and Inuit students at InFocus Film School: band funding, scholarships and bursaries, and our commitment to Truth and Reconciliation."
>
  <Nav />

  <main>
    <PageHero
      title="Indigenous Students"
      crumbs={[{ label: 'Home', href: '/' }, { label: 'Admissions', href: '/admissions/how-to-apply' }, { label: 'Indigenous Students' }]}
    >
      <p>
        Indigenous students can receive up to 100% non-repayable financial support to study Film
        Production, Screenwriting, 3D Animation, Visual Effects, Documentary or Graphic Design in
        Vancouver, Canada.
      </p>
    </PageHero>

    <!-- Land acknowledgement. The motif is topographic contour lines, the
         land and water itself, rather than borrowed Nations' artwork. -->
