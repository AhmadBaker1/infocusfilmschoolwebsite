---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import PageHero from '../../components/PageHero.astro';
import Cta from '../../components/Cta.astro';
import Footer from '../../components/Footer.astro';

// Videos play in place: pressing play swaps the thumbnail for the embed, and
// YouTube's own fullscreen button maximizes it. The title links to YouTube as
// a no-JavaScript fallback. Set `yt` to null for "coming soon".
// TODO: two guides (adaptations, sex scenes) have no article yet; set `url`
// on them once they exist.
const videos: {
  kind: string;
  title: string;
  instructor: string;
  img: string;
  yt: string | null;
  text: string;
}[] = [
  {
    kind: '3D Animation',
    title: 'Intro to Animation + Modelling',
    instructor: 'Miguel Rodriguez',
    // The video's own YouTube thumbnail, saved locally.
    img: '/images/tutorial-3d-animation.jpg',
    yt: 'utS32WP8_b8',
    text: 'One of the key tools in the industry is Autodesk Maya, a standard for 3D modelling and animation. Learn the fundamentals of animating a bouncing ball in Maya, no hand-drawn frames required.',
  },
  {
    kind: 'Graphic Design',
    title: 'Graphic Design Intro',
    instructor: 'Leila Singleton',
    // YouTube's thumbnail for this one is low-res and full of other brands'
    // logos, so the program photo stands in.
    img: '/images/program-graphic-digital-design.jpg',
    yt: 'xj2zMk6si48',
    text: 'The fundamentals of designing for businesses: communicating through design, selecting imagery, colour theory, and how to pursue a career in the design industry.',
  },
];

type Guide = {
  cat: 'howto' | 'industry';
  icon: string;
  title: string;
  text: string;
  url: string | null;
};

const guides: Guide[] = [
  {
    cat: 'howto',
    icon: 'lens',
    title: 'Glass Eyes: Lens Use in Cinema',
    text: 'If cinematography is the art of storytelling in film, lenses are the canvas. An in-depth look at why choosing the right lens is critical to building a relationship with your audience.',
    url: '/how-to-use-lenses-in-film/',
  },
  {
    cat: 'howto',
    icon: 'screen',
    title: 'Filming with Green Screen: Everything You Need to Know',
    text: 'Green screen keying layers two images or video streams together, so you can drop in any background a scene needs, from alien worlds to hard-to-reach locations. Everything you need to get started.',
    url: '/how-to-film-with-green-screen/',
  },
  {
    cat: 'howto',
    icon: 'book',
    title: 'Adapting Short Stories into Feature Films',
    text: 'The Birds, Brokeback Mountain and Memento all began as short stories. How does a writer take a short story and adapt it into a feature screenplay?',
    url: null,
  },
  {
    cat: 'howto',
    icon: 'slate',
    title: 'How to Film a Sex Scene',
    text: 'Nudity and sex scenes are a sensitive subject. How to handle them professionally, respectfully and safely on set.',
    url: null,
  },
  {
    cat: 'industry',
    icon: 'chair',
    title: 'What Is a Creative Producer?',
    text: 'Producers are involved in almost every stage, from development and funding to shooting, editing and promotion. The job has a reputation for being thankless and not very creative. We show why that stereotype may not be accurate.',
    url: '/creative-producer-filmmaker/',
  },
  {
    cat: 'industry',
    icon: 'viewfinder',
    title: 'What Is Auteur Theory in Filmmaking?',
    text: 'An auteur is an artist who applies a high degree of stylistic control over their craft. See how Scorsese, Kubrick, Lynch, Burton, Kurosawa and others made the case for auteur filmmaking.',
    url: '/auteur-theory-director-filmmakers/',
  },
  {
    cat: 'industry',
    icon: 'set',
    title: 'The Art of Production Design',
    text: 'How a character dresses, what their home looks like, their cubicle at work: every choice the art department makes deepens the world. Meet the production designer, one of the most creative roles on set.',
    url: '/introduction-production-design/',
  },
];

const catLabel = { howto: 'Guides + How-Tos', industry: 'Understanding the Industry' };
---

<Base
  title="Guides + Tutorials — InFocus Film School"
  description="Free video tutorials, filmmaking how-tos and industry guides from InFocus Film School instructors: Maya animation, graphic design, lenses, green screen and more."
>
  <Nav />

  <main>
    <PageHero
      title="Guides + Tutorials"
      crumbs={[{ label: 'Home', href: '/' }, { label: 'Resources' }, { label: 'Tutorials' }]}
    >
      <p>
        Tutorials and articles for new and experienced artists alike, from shooting and
        compositing green screen and choosing lenses to animating in Maya, plus industry insight,
        film reviews and news.
      </p>
    </PageHero>

    <!-- Free videos -->
    <section class="videos" aria-labelledby="videos-title">
      <div class="videos__inner">
        <header class="head">
          <p class="eyebrow"><span aria-hidden="true"></span>Free video tutorials</p>
          <h2 id="videos-title" class="head__title">Learn from our instructors</h2>
        </header>

        <ul class="videos__grid">
          {videos.map((v) => (
            <li class:list={['video', { 'is-soon': !v.yt }]}>
              <div class="video__frame">
                <img src={v.img} alt="" width="1200" height="800" loading="lazy" decoding="async" />
                <span class="video__scrim" aria-hidden="true" />
                <span class="video__kind">{v.kind}</span>
                {v.yt ? (
                  <button type="button" class="video__play" data-yt={v.yt} data-title={v.title} aria-label={`Play video: ${v.title}`}>
                    <span class="video__ring" aria-hidden="true">
                      <svg viewBox="0 0 24 24"><path d="M8.5 6.2v11.6c0 .8.9 1.3 1.6.8l9-5.8c.6-.4.6-1.3 0-1.7l-9-5.8c-.7-.4-1.6 0-1.6.9Z" /></svg>
                    </span>
                    <span class="video__label">Play class</span>
                  </button>
                ) : (
                  <span class="video__soon">Video coming soon</span>
                )}
              </div>
              <div class="video__body">
                {v.yt ? (
                  <a class="video__title" href={`https://www.youtube.com/watch?v=${v.yt}`} target="_blank" rel="noopener">{v.title}</a>
                ) : (
                  <span class="video__title">{v.title}</span>
                )}
                <span class="video__by">With instructor {v.instructor}</span>
                <span class="video__text">{v.text}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Guide library -->
    <section class="library" aria-labelledby="library-title">
      <div class="library__inner">
        <header class="library__head">
          <div>
            <p class="eyebrow"><span aria-hidden="true"></span>Popular posts</p>
            <h2 id="library-title" class="head__title head__title--dark">Guides + articles</h2>
          </div>
          <div class="filters" role="group" aria-label="Filter guides">
            <button type="button" class="filter" data-filter="all" aria-pressed="true">All</button>
            <button type="button" class="filter" data-filter="howto" aria-pressed="false">How-Tos</button>
            <button type="button" class="filter" data-filter="industry" aria-pressed="false">Industry</button>
          </div>
        </header>

        <ul class="guides">
          {guides.map((g, i) => {
            const Tag = g.url ? 'a' : 'div';
            return (
              <li class="guides__item" data-cat={g.cat} style={`--i:${i}`}>
                <Tag class:list={['guide', { 'is-soon': !g.url }]} href={g.url ?? undefined}>
                  <span class="guide__top">
                    <span class="guide__icon" aria-hidden="true">
                      <svg viewBox="0 0 48 48">
                        {g.icon === 'lens' && (
                          <>
                            <circle cx="24" cy="24" r="18" />
                            <circle cx="24" cy="24" r="11" />
                            <circle cx="24" cy="24" r="4" />
                            <path d="M24 6v4M42 24h-4M24 42v-4M6 24h4" />
                          </>
                        )}
                        {g.icon === 'screen' && (
                          <>
                            <rect x="6" y="8" width="36" height="28" />
                            <circle cx="24" cy="19" r="4" />
                            <path d="M16 36c0-6 4-10 8-10s8 4 8 10M14 42h20" />
                          </>
                        )}
                        {g.icon === 'book' && (
                          <>
                            <path d="M24 12c-5-4-12-4-18-2v28c6-2 13-2 18 2 5-4 12-4 18-2V10c-6-2-13-2-18 2Z" />
                            <path d="M24 12v28" />
                          </>
                        )}
                        {g.icon === 'slate' && (
                          <>
                            <rect x="6" y="18" width="36" height="24" />
                            <path d="M6 18l4-8 32-2 0 6-36 4M16 9.5l-3 7M26 9l-3 7.5M36 8.5l-3 7.5" />
                            <path d="M12 28h24M12 34h14" />
                          </>
                        )}
                        {g.icon === 'chair' && (
                          <>
                            <path d="M12 8v20M36 8v20M12 12h24M12 20h24M8 28h32M12 28l-4 14M36 28l4 14M14 36h20" />
                          </>
                        )}
                        {g.icon === 'viewfinder' && (
                          <>
                            <path d="M6 14V6h8M34 6h8v8M42 34v8h-8M14 42H6v-8" />
                            <path d="M24 18v12M18 24h12" />
                          </>
                        )}
                        {g.icon === 'set' && (
                          <>
                            <path d="M6 40h36M10 40V16h28v24M10 16l14-10 14 10" />
                            <rect x="16" y="24" width="8" height="16" />
                            <rect x="28" y="24" width="6" height="6" />
                          </>
                        )}
                      </svg>
                    </span>
                    <span class="guide__cat">{catLabel[g.cat]}</span>
                  </span>
                  <span class="guide__title">{g.title}</span>
                  <span class="guide__text">{g.text}</span>
                  <span class="guide__cta">
                    {g.url ? <>Read guide <span aria-hidden="true">→</span></> : 'Article coming soon'}
                  </span>
                </Tag>
              </li>
            );
          })}
        </ul>

        <a class="library__more" href="/resources/blog">
          Read more on the blog <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </main>

  <Cta />
  <Footer />
</Base>

<style>
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 clamp(12px, 1.4vw, 20px);
    font-family: var(--font-head);
    font-size: clamp(11px, 0.8vw, 13px);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--red);
  }

  .eyebrow span {
    width: clamp(24px, 2.6vw, 44px);
    height: 2px;
    background: var(--red);
  }

  .head__title {
    margin: 0;
    font-size: clamp(30px, 3.4vw, 60px);
    line-height: 1;
  }

  /* ---- Videos ---- */

  .videos {
    padding: clamp(52px, 6.5vw, 108px) var(--gutter);
    background:
      radial-gradient(60% 80% at 100% 0%, rgba(189, 47, 47, 0.16), transparent 65%),
      var(--charcoal);
    color: var(--white);
  }

  .videos__inner,
  .library__inner {
    max-width: 1440px;
    margin: 0 auto;
  }

  .videos__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 32px);
    margin: clamp(26px, 3vw, 44px) 0 0;
    padding: 0;
    list-style: none;
  }

  .video {
    display: grid;
    gap: clamp(16px, 1.6vw, 22px);
  }

  .video__frame {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 14px;
    background: #111;
  }

  .video__frame > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .video__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video__scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 50%, rgba(0, 0, 0, 0.28), transparent 45%),
      linear-gradient(to top, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.05) 60%);
    transition: opacity 0.4s ease;
  }

  /* The whole frame is the hit area; the ring sits centred with a label. */
  .video__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 12px;
    width: 100%;
    cursor: pointer;
  }

  .video__ring {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(64px, 5.6vw, 88px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
    border: 1.5px solid rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 10px 30px -8px rgba(0, 0, 0, 0.5);
    transition:
      background-color 0.35s ease,
      border-color 0.35s ease,
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Slow outer pulse, so it reads as playable at a glance. */
  .video__ring::after {
    content: '';
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.35);
    animation: ring 2.4s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  @keyframes ring {
    from {
      opacity: 0.9;
      transform: scale(0.9);
    }
    to {
      opacity: 0;
      transform: scale(1.25);
    }
  }

  .video__ring svg {
    width: 38%;
    margin-left: 7%;
    fill: var(--white);
  }

  .video__label {
    font-family: var(--font-head);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--white);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
    opacity: 0.9;
    transition: opacity 0.3s ease;
  }

  .video__play:hover .video__ring,
  .video__play:focus-visible .video__ring {
    background: var(--red);
    border-color: var(--red);
    transform: scale(1.08);
  }

  .video__play:hover .video__label {
    opacity: 1;
  }

  .video__frame:hover > img {
    transform: scale(1.04);
  }

  .video__play:focus-visible {
    outline: none;
  }

  /* Once playing, only the embed shows. */
  .video__frame.is-playing > :not(iframe) {
    display: none;
  }

  .video__kind,
  .video__soon {
    position: absolute;
    top: 14px;
    padding: 6px 12px;
    border-radius: 999px;
    font-family: var(--font-head);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .video__kind {
    left: 14px;
    background: var(--red);
    color: var(--white);
  }

  .video__soon {
    right: 14px;
    background: rgba(0, 0, 0, 0.65);
    color: rgba(255, 255, 255, 0.85);
  }

  .video__body {
    display: grid;
    gap: 6px;
  }

  .video__title {
    font-family: var(--font-head);
    font-size: clamp(20px, 1.8vw, 30px);
    font-weight: 600;
    line-height: 1.1;
    text-transform: uppercase;
  }

  a.video__title {
    transition: color 0.2s ease;
  }

  a.video__title:hover {
    color: var(--red);
  }

  .video__by {
    font-size: 13px;
    color: var(--red);
    font-weight: 600;
  }

  .video__text {
    max-width: 60ch;
    font-size: 15px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.72);
  }

  /* ---- Library ---- */

  .library {
    padding: clamp(52px, 6.5vw, 108px) var(--gutter);
    background: var(--white);
    color: var(--charcoal);
  }

  .library__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: clamp(24px, 2.8vw, 40px);
  }

  .filters {
    display: flex;
    gap: 8px;
  }

  .filter {
    padding: 9px 16px;
    border: 1px solid rgba(51, 51, 51, 0.24);
    border-radius: 999px;
    font-size: 14px;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .filter:hover {
    border-color: var(--charcoal);
  }

  .filter[aria-pressed='true'] {
    border-color: var(--charcoal);
    background: var(--charcoal);
    color: var(--white);
  }

  .guides {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    /* Hairlines on the cells, not a gap over a grey backdrop, so a short
       last row leaves white space instead of grey blocks. */
    border-top: 1px solid rgba(51, 51, 51, 0.14);
    border-left: 1px solid rgba(51, 51, 51, 0.14);
  }

  .guides__item {
    border-right: 1px solid rgba(51, 51, 51, 0.14);
    border-bottom: 1px solid rgba(51, 51, 51, 0.14);
    background: var(--white);
    animation: card-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--i) * 40ms);
  }

  .guides__item[hidden] {
    display: none;
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  .guide {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    padding: clamp(22px, 2.4vw, 34px);
    transition: background-color 0.3s ease;
  }

  a.guide:hover {
    background: #fafafa;
  }

  .guide__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 6px;
  }

  .guide__icon svg {
    width: 48px;
    height: 48px;
    fill: none;
    stroke: var(--charcoal);
    stroke-width: 1.6;
    stroke-linejoin: round;
    stroke-linecap: round;
    transition: stroke 0.3s ease;
  }

  a.guide:hover .guide__icon svg {
    stroke: var(--red);
  }

  .guide__cat {
    font-family: var(--font-head);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--red);
    text-align: right;
  }

  .guide__title {
    font-family: var(--font-head);
    font-size: clamp(18px, 1.5vw, 24px);
    font-weight: 600;
    line-height: 1.12;
    text-transform: uppercase;
  }

  .guide__text {
    font-size: 14px;
    line-height: 1.65;
    color: #555;
  }

  .guide__cta {
    margin-top: auto;
    padding-top: 8px;
    font-family: var(--font-head);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .guide.is-soon .guide__cta {
    color: #9a9a9a;
  }

  .library__more {
    display: inline-flex;
    gap: 10px;
    margin-top: clamp(28px, 3vw, 44px);
    padding-bottom: 8px;
    border-bottom: 2px solid var(--red);
    font-family: var(--font-head);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  .library__more:hover {
    color: var(--red);
  }

  @media (max-width: 1000px) {
    .guides {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .videos__grid,
    .guides {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  // Play in place: swap the thumbnail for a privacy-enhanced embed. YouTube's
  // fullscreen control handles maximizing.
  document.querySelectorAll<HTMLButtonElement>('button[data-yt]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const frame = btn.closest<HTMLElement>('.video__frame');
      if (!frame) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.yt}?autoplay=1&rel=0&modestbranding=1`;
      iframe.title = btn.dataset.title ?? 'Video';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      frame.append(iframe);
      frame.classList.add('is-playing');
      iframe.focus();
    })
  );

  const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('.guides__item');

  filters.forEach((f) =>
    f.addEventListener('click', () => {
      const cat = f.dataset.filter;
      filters.forEach((x) => x.setAttribute('aria-pressed', String(x === f)));
      let n = 0;
      items.forEach((item) => {
        const show = cat === 'all' || item.dataset.cat === cat;
        item.hidden = !show;
        // Restart the entrance so the filtered set cascades in.
        if (show) {
          item.style.setProperty('--i', String(n++));
          item.style.animation = 'none';
          void item.offsetWidth;
          item.style.animation = '';
        }
      });
    })
  );
</script>
