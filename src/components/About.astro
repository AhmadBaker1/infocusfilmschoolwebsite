---
// Several cards run past the box on purpose and are cut off by the section
// edge — the cluster reads as a fragment of something larger, not a tidy grid.
const cards = [
  { src: '/images/about-1.jpg', x: 2, y: 3, w: 52, alt: 'Students and instructors talking at an InFocus campus event' },
  { src: '/images/about-2.jpg', x: 62, y: 0, w: 56, alt: 'Student operating a cinema camera on a dressed interior set' },
  { src: '/images/about-3.jpg', x: -2, y: 30, w: 48, alt: 'Two students building a camera rig in the studio' },
  { src: '/images/about-4.jpg', x: 44, y: 34, w: 60, alt: 'Crew setting up lights and a bounce board for a shot' },
  { src: '/images/about-5.jpg', x: 6, y: 62, w: 50, alt: 'Student reviewing an animated scene on a field monitor' },
  { src: '/images/about-6.jpg', x: 58, y: 68, w: 58, alt: 'Field monitor showing an interview subject during a shoot' },
];

// Taken verbatim from the paragraph copy rather than invented.
const programs = [
  'Film Production',
  '3D Animation',
  'Visual Effects',
  'Screenwriting',
  'Digital Graphic Design',
];
---

<section class="about" id="about">
  <div class="about__inner">
    <div class="about__copy">
      <p class="eyebrow"><span aria-hidden="true"></span>Est. 2010 — Vancouver, BC</p>

      <h2 class="about__heading">
        <span class="about__heading-line">About</span>
        <span class="about__heading-line about__heading-line--mark">InFocus</span>
      </h2>

      <p class="lead">
        InFocus Film School is an independent film school built on the premise of providing an
        accelerated education in film and entertainment arts. Originally founded as a non-profit
        society in 2010, InFocus has become Vancouver’s top cinematic arts training institution,
        offering diploma and certificate programs in film production, 3D animation, visual effects,
        screenwriting, and digital graphic design. While our structure has changed over the years,
        the growth of emerging artists, storytellers, and the arts and entertainment industry as a
        whole has remained at the core of everything we do.
      </p>

      <p class="body">
        InFocus Film School provides a superior education through accelerated, hands-on learning.
        InFocus’ industry-professional instructors mentor students through interactive classes with
        a focus on building a strong portfolio. We encourage students to grow as visual storytellers,
        to realize their personal artistic visions, and to maintain creative autonomy as they enter
        Vancouver’s multi-billion dollar film industry.
      </p>

      <div class="disciplines">
        <span class="disciplines__label">What we teach</span>
        <ul class="chips">
          {programs.map((p) => <li>{p}</li>)}
        </ul>
      </div>

      <a class="about__cta" href="/programs">Explore Programs</a>
    </div>

    <div class="about__collage">
      {
        cards.map((c, i) => (
          <figure
            class="card"
            style={`left:${c.x}%; top:${c.y}%; width:${c.w}%; z-index:${i + 1}; --i:${i}`}
          >
            <img src={c.src} alt={c.alt} width="1200" height="800" loading="lazy" decoding="async" />
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--white);
    color: var(--charcoal);
    padding: clamp(64px, 8.5vw, 148px) var(--gutter);
    /* Clips the cards that run past the collage box at the page edge. */
    overflow: hidden;
  }

  .about__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    gap: clamp(32px, 5vw, 84px);
    align-items: center;
    max-width: 1600px;
    margin: 0 auto;
  }

  /* ---- Copy column ---- */

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 clamp(14px, 1.5vw, 22px);
    font-family: var(--font-head);
    font-size: clamp(11px, 0.8vw, 13px);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--red);
  }

  .eyebrow span {
    width: clamp(28px, 3vw, 52px);
    height: 2px;
    background: var(--red);
  }

  .about__heading {
    margin: 0 0 clamp(20px, 2.2vw, 34px);
    font-size: clamp(38px, 4.6vw, 86px);
    font-weight: 600;
    line-height: 0.94;
    letter-spacing: 0.005em;
  }

  .about__heading-line {
    display: block;
  }

  /* Outlined second line — echoes the display treatment without a second face. */
  .about__heading-line--mark {
    color: transparent;
    -webkit-text-stroke: 1.4px var(--charcoal);
  }

  .lead {
    margin: 0 0 1em;
    font-size: clamp(16px, 1.2vw, 21px);
    line-height: 1.55;
    max-width: 54ch;
  }

  .body {
    margin: 0;
    color: #5c5c5c;
    font-size: clamp(14px, 1vw, 17px);
    line-height: 1.68;
    max-width: 58ch;
  }

  .disciplines {
    margin-top: clamp(26px, 3vw, 44px);
    padding-top: clamp(20px, 2.2vw, 32px);
    border-top: 1px solid rgba(51, 51, 51, 0.16);
  }

  .disciplines__label {
    display: block;
    margin-bottom: 14px;
    font-family: var(--font-head);
    font-size: clamp(10px, 0.75vw, 12px);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8a8a8a;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: 7px 14px;
    border: 1px solid rgba(51, 51, 51, 0.24);
    border-radius: 999px;
    font-family: var(--font-head);
    font-size: clamp(11px, 0.8vw, 13px);
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .about__cta {
    display: inline-grid;
    place-items: center;
    min-width: clamp(190px, 16vw, 260px);
    margin-top: clamp(26px, 3vw, 44px);
    padding: clamp(15px, 1.5vw, 21px) clamp(20px, 2vw, 32px);
    background: var(--charcoal);
    color: var(--white);
    font-family: var(--font-head);
    font-size: clamp(11px, 0.85vw, 14px);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: background-color 0.2s ease;
  }

  .about__cta:hover {
    background: var(--red);
  }

  /* ---- Collage ---- */

  .about__collage {
    position: relative;
    aspect-ratio: 1 / 1;
  }

  .card {
    position: absolute;
    margin: 0;
    /* White keyline separates cards that would otherwise merge on a
       white background, since several frames are dark. */
    border: 6px solid var(--white);
    box-shadow: 0 18px 38px rgba(0, 0, 0, 0.26);
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card:hover {
    transform: translateY(-8px);
    z-index: 20 !important;
  }

  .card img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  /* ---- Scroll reveal ---- */

  .about__copy > *,
  .card {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .about.is-in .about__copy > *,
  .about.is-in .card {
    opacity: 1;
    transform: translateY(0);
  }

  .about.is-in .about__copy > *:nth-child(1) { transition-delay: 0.02s; }
  .about.is-in .about__copy > *:nth-child(2) { transition-delay: 0.08s; }
  .about.is-in .about__copy > *:nth-child(3) { transition-delay: 0.14s; }
  .about.is-in .about__copy > *:nth-child(4) { transition-delay: 0.2s; }
  .about.is-in .about__copy > *:nth-child(5) { transition-delay: 0.26s; }
  .about.is-in .about__copy > *:nth-child(6) { transition-delay: 0.32s; }
  .about.is-in .card { transition-delay: calc(0.12s + var(--i) * 0.075s); }

  /* Hover lift must not fight the reveal transform. */
  .about.is-in .card:hover {
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .about__copy > *,
    .card {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .card:hover {
      transform: none;
    }
  }

  @media (max-width: 1000px) {
    .about__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(40px, 6vw, 60px);
    }

    .lead,
    .body {
      max-width: none;
    }
  }

  /* Overlap needs room; below this the cards tile instead. */
  @media (max-width: 700px) {
    .about__collage {
      position: static;
      aspect-ratio: auto;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .card {
      position: static;
      width: auto !important;
      border-width: 4px;
      box-shadow: 0 8px 18px rgba(0, 0, 0, 0.18);
    }

    .about__cta {
      width: 100%;
    }
  }
</style>

<script>
  // Reveal once the section enters view. Falls back to visible if the
  // observer never fires, so copy can never be stranded at opacity 0.
  const section = document.querySelector('.about');

  if (section) {
    if (!window.IntersectionObserver) {
      section.classList.add('is-in');
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      io.observe(section);
    }
  }
</script>
