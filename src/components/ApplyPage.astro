---
// Full-screen application page: role summary on the left, sectioned form on
// the right. Used by /careers/<id>/apply (a role) and /careers/apply
// (general application).
//
// BACKEND: the form POSTs multipart/form-data to PUBLIC_CAREERS_ENDPOINT with:
//   role, first_name, last_name, email, phone_country (e.g. "CA +1"), phone, city, province,
//   country, work_eligible ("yes"|"no"), resume (file), cover_letter_file
//   (file, optional), cover_letter (text), portfolio_url, linkedin_url,
//   start_date, heard_from, consent ("yes").
// With no endpoint set, submitting shows a notice and sends nothing.
import Base from '../layouts/Base.astro';
import { DEPTS, EMAIL, GENERAL, summarize, type Job } from '../lib/jobs';
import { COUNTRIES, PINNED } from '../lib/countries';
import PhoneField from './PhoneField.astro';

interface Props {
  job?: Job;
}

const { job } = Astro.props;
const role = job?.title ?? GENERAL;
const summary = job ? summarize(job) : null;
const back = job ? `/careers/${job.id}` : '/careers';
const ENDPOINT = import.meta.env.PUBLIC_CAREERS_ENDPOINT ?? '';

const provinces = [
  'Alberta', 'British Columbia', 'Manitoba', 'New Brunswick', 'Newfoundland and Labrador',
  'Northwest Territories', 'Nova Scotia', 'Nunavut', 'Ontario', 'Prince Edward Island',
  'Quebec', 'Saskatchewan', 'Yukon', 'Outside Canada',
];
// Pinned countries first, then everyone A–Z.
const pinned = PINNED.map((iso) => COUNTRIES.find((c) => c.iso === iso)!);
const rest = COUNTRIES.filter((c) => !PINNED.includes(c.iso));
const steps = ['Personal details', 'Location', 'Eligibility', 'Documents', 'A bit more'];
---

<Base
  title={`Apply: ${role} — InFocus Film School`}
  description={job ? `Apply for ${job.title} at InFocus Film School.` : 'Send a general application to InFocus Film School.'}
>
  <div class="shell">
    <!-- ===== Role panel ===== -->
    <aside class="panel">
      <div class="panel__inner">
        <div class="panel__top">
          <a class="panel__logo" href="/" aria-label="InFocus Film School home">
            <img src="/images/logo-on-dark.png" alt="InFocus Film School" width="1090" height="390" />
          </a>
          <a class="panel__back" href={back}><span aria-hidden="true">←</span> {job ? 'Back to role' : 'Back to careers'}</a>
        </div>

        <div class="role">
          <p class="role__dept"><span aria-hidden="true"></span>{job ? DEPTS[job.dept] : 'Join our team'}</p>
          <h1 class="role__title">{job ? job.title : 'General application'}</h1>

          {
            job ? (
              <>
                <ul class="role__facts">
                  <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
                    {job.location}
                  </li>
                  <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></svg>
                    {job.type}
                  </li>
                </ul>
                <p class="role__pay">{job.pay}</p>
              </>
            ) : (
              <p class="role__lede">
                Don’t see a role that fits? Tell us how you’d like to contribute. We review every
                application and reach out when there’s a match.
              </p>
            )
          }

          {
            summary?.about && (
              <div class="role__block">
                <h2>About this role</h2>
                <p>{summary.about}</p>
              </div>
            )
          }
          {
            summary && summary.lookingFor.length > 0 && (
              <div class="role__block">
                <h2>What we’re looking for</h2>
                <ul class="role__list">
                  {summary.lookingFor.map((l) => <li>{l}</li>)}
                </ul>
              </div>
            )
          }
          {job && <a class="role__full" href={back}>Read the full job description <span aria-hidden="true">→</span></a>}
        </div>

        <p class="panel__foot">
          Questions? <a href={`mailto:${EMAIL}?subject=${encodeURIComponent(`Question: ${role}`)}`}>{EMAIL}</a>
        </p>
      </div>
    </aside>

    <!-- ===== Form ===== -->
    <main class="main">
      <div class="main__inner">
        <div class="progress" aria-hidden="true">
          <div class="progress__bar"><span data-progress></span></div>
          <ol class="progress__steps">
            {steps.map((s, i) => <li data-step-dot={i}><span>{String(i + 1).padStart(2, '0')}</span>{s}</li>)}
          </ol>
        </div>

        <div data-view="form">
          <header class="head">
            <p class="head__eyebrow"><span aria-hidden="true"></span>Your application</p>
            <h2 class="head__title">Apply for this role</h2>
            <p class="head__text">It takes about five minutes. Fields marked <span class="req">*</span> are required.</p>
          </header>

          <form class="form" data-form data-endpoint={ENDPOINT} method="post" action={ENDPOINT || undefined} enctype="multipart/form-data" novalidate>
            <input type="hidden" name="role" value={role} />

            <!-- 01 -->
            <fieldset class="sec" data-step="0">
              <legend class="sec__title"><span>01</span>Personal details</legend>
              <div class="grid">
                <label class="field">
                  <span class="field__label">First name <span class="req">*</span></span>
                  <input name="first_name" autocomplete="given-name" placeholder="Jane" required />
                </label>
                <label class="field">
                  <span class="field__label">Last name <span class="req">*</span></span>
                  <input name="last_name" autocomplete="family-name" placeholder="Smith" required />
                </label>
                <label class="field field--wide">
                  <span class="field__label">Email address <span class="req">*</span></span>
                  <input name="email" type="email" autocomplete="email" placeholder="jane@example.com" required />
                </label>
                <div class="field field--wide">
                  <label class="field__label" for="phone">Phone <span class="req">*</span></label>
                  <PhoneField />
                </div>
              </div>
            </fieldset>

            <!-- 02 -->
            <fieldset class="sec" data-step="1">
              <legend class="sec__title"><span>02</span>Location</legend>
              <div class="grid">
                <label class="field">
                  <span class="field__label">Current city <span class="req">*</span></span>
                  <input name="city" autocomplete="address-level2" placeholder="Vancouver" required />
                </label>
                <label class="field">
                  <span class="field__label">Province / territory <span class="req">*</span></span>
                  <select name="province" required>
                    <option value="">Select province</option>
                    {provinces.map((p) => <option>{p}</option>)}
                  </select>
                </label>
                <label class="field field--wide">
                  <span class="field__label">Country <span class="req">*</span></span>
                  <select name="country" required>
                    {pinned.map((c) => <option selected={c.iso === 'CA'}>{c.name}</option>)}
                    <option disabled>──────────</option>
                    {rest.map((c) => <option>{c.name}</option>)}
                  </select>
                </label>
              </div>
            </fieldset>

            <!-- 03 -->
            <fieldset class="sec" data-step="2">
              <legend class="sec__title"><span>03</span>Eligibility</legend>
              <p class="field__label">Are you eligible to work in Canada? <span class="req">*</span></p>
              <div class="choices" role="radiogroup">
                <label class="choice">
                  <input type="radio" name="work_eligible" value="yes" required />
                  <span><strong>Yes</strong>I’m eligible to work in Canada</span>
                </label>
                <label class="choice">
                  <input type="radio" name="work_eligible" value="no" />
                  <span><strong>No</strong>I would need sponsorship or a permit</span>
                </label>
              </div>
            </fieldset>

            <!-- 04 -->
            <fieldset class="sec" data-step="3">
              <legend class="sec__title"><span>04</span>Documents</legend>
              <div class="drop" data-drop>
                <input id="resume" class="drop__input" name="resume" type="file" accept=".pdf,.doc,.docx" required data-file />
                <label for="resume" class="drop__zone">
                  <span class="drop__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M12 16V4M7 9l5-5 5 5M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3" /></svg>
                  </span>
                  <span class="drop__title">Resume / CV <span class="req">*</span></span>
                  <span class="drop__text" data-file-name>Drag a file here or <u>browse</u><br />PDF, DOC or DOCX, max 10 MB</span>
                </label>
              </div>

              <div class="drop drop--small" data-drop>
                <input id="cover" class="drop__input" name="cover_letter_file" type="file" accept=".pdf,.doc,.docx" data-file-optional />
                <label for="cover" class="drop__zone">
                  <span class="drop__title">Cover letter <span class="opt">optional</span></span>
                  <span class="drop__text" data-file-name>Upload a file, or write a short note below</span>
                </label>
              </div>

              <label class="field">
                <span class="field__label">Why this role? <span class="opt">optional</span></span>
                <textarea name="cover_letter" rows="5" placeholder="Tell us why you’re excited about this role and about InFocus."></textarea>
              </label>
            </fieldset>

            <!-- 05 -->
            <fieldset class="sec" data-step="4">
              <legend class="sec__title"><span>05</span>A bit more</legend>
              <div class="grid">
                <label class="field">
                  <span class="field__label">Portfolio or website</span>
                  <input name="portfolio_url" type="url" placeholder="https://" />
                </label>
                <label class="field">
                  <span class="field__label">LinkedIn</span>
                  <input name="linkedin_url" type="url" placeholder="https://linkedin.com/in/" />
                </label>
                <label class="field">
                  <span class="field__label">Earliest start date</span>
                  <input name="start_date" type="date" />
                </label>
                <label class="field">
                  <span class="field__label">How did you hear about us?</span>
                  <select name="heard_from">
                    <option value="">Select</option>
                    <option>InFocus website</option>
                    <option>Indeed</option>
                    <option>LinkedIn</option>
                    <option>Referral</option>
                    <option>Social media</option>
                    <option>Other</option>
                  </select>
                </label>
              </div>

              <label class="consent">
                <input type="checkbox" name="consent" value="yes" required />
                <span>
                  I agree to be contacted by InFocus Film School about my application. We never sell
                  or share your information. <a href="/privacy">Privacy policy</a>.
                </span>
              </label>
            </fieldset>

            <div class="submit">
              <p class="submit__status" data-status role="status" aria-live="polite"></p>
              <button type="submit" class="submit__btn" data-submit>
                Submit application <span aria-hidden="true">→</span>
              </button>
            </div>

            <p class="eq">
              InFocus Film School is committed to building a diverse, equitable and inclusive
              workplace. We welcome applications from people of all backgrounds, identities and lived
              experiences, including Indigenous Peoples, racialized persons, persons with disabilities
              and members of the 2SLGBTQIA+ community.
            </p>
          </form>
        </div>

        <!-- Success -->
        <div class="done" data-view="done" hidden tabindex="-1">
          <span class="done__icon" aria-hidden="true">
            <svg viewBox="0 0 52 52">
              <circle class="done__ring" cx="26" cy="26" r="24" />
              <path class="done__tick" d="M15 27l7.5 7.5L37.5 18" />
            </svg>
          </span>
          <h2 class="done__title">Application sent</h2>
          <p class="done__text">
            Thank you for applying{job ? ` for ${job.title}` : ''}. Our team reviews applications on a
            rolling basis, and we’ll be in touch if there’s a match.
          </p>
          <div class="done__actions">
            <a class="submit__btn" href="/careers">See other roles <span aria-hidden="true">→</span></a>
            <a class="done__link" href="/">Back to home</a>
          </div>
        </div>
      </div>
    </main>
  </div>
</Base>

<style>
  .shell {
    display: grid;
    grid-template-columns: minmax(340px, 0.42fr) minmax(0, 1fr);
    min-height: 100vh;
    background: var(--white);
    color: var(--charcoal);
  }

  /* ================= Panel ================= */

  .panel {
    position: relative;
    isolation: isolate;
    /* clip, not hidden: hidden would stop the inner panel from sticking. */
    overflow: clip;
    background:
      radial-gradient(70% 50% at 100% 0%, rgba(189, 47, 47, 0.32), transparent 65%),
      radial-gradient(70% 50% at 0% 100%, rgba(34, 68, 102, 0.55), transparent 70%),
      var(--black);
    color: var(--white);
  }

  /* Viewfinder corners. */
  .panel::before,
  .panel::after {
    content: '';
    position: absolute;
    width: 26px;
    height: 26px;
    border: 0 solid rgba(255, 255, 255, 0.4);
    z-index: -1;
  }

  .panel::before {
    top: 18px;
    right: 18px;
    border-top-width: 2px;
    border-right-width: 2px;
  }

  .panel::after {
    bottom: 18px;
    left: 18px;
    border-bottom-width: 2px;
    border-left-width: 2px;
  }

  .panel__inner {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4vh, 48px);
    min-height: 100vh;
    max-height: 100vh;
    overflow-y: auto;
    padding: clamp(28px, 3.4vw, 52px) clamp(24px, 3vw, 48px);
    scrollbar-width: thin;
  }

  .panel__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .panel__logo img {
    width: auto;
    height: 36px;
  }

  .panel__back {
    font-family: var(--font-head);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
    transition: color 0.2s ease;
  }

  .panel__back:hover {
    color: var(--white);
  }

  .role {
    display: grid;
    gap: 18px;
  }

  .role__dept {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    font-family: var(--font-head);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--red);
  }

  .role__dept span {
    width: 32px;
    height: 2px;
    background: var(--red);
  }

  .role__title {
    margin: 0;
    font-size: clamp(34px, 3.4vw, 56px);
    line-height: 0.95;
  }

  .role__lede {
    margin: 0;
    font-size: 15px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.72);
  }

  .role__facts {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .role__facts li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    color: rgba(255, 255, 255, 0.85);
  }

  .role__facts svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: var(--red);
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .role__pay {
    justify-self: start;
    margin: 0;
    padding: 10px 16px;
    border: 1px solid rgba(189, 47, 47, 0.6);
    border-radius: 10px;
    background: rgba(189, 47, 47, 0.14);
    font-family: var(--font-head);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .role__block {
    padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .role__block h2 {
    margin: 0 0 10px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.5);
  }

  .role__block p {
    margin: 0;
    font-size: 14px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.78);
  }

  .role__list {
    display: grid;
    gap: 9px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .role__list li {
    position: relative;
    padding-left: 18px;
    font-size: 14px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.82);
  }

  .role__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--red);
  }

  .role__full {
    justify-self: start;
    padding-bottom: 5px;
    border-bottom: 2px solid var(--red);
    font-family: var(--font-head);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .panel__foot {
    margin: auto 0 0;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.5);
  }

  .panel__foot a {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ================= Main ================= */

  .main {
    padding: clamp(28px, 4vw, 64px) clamp(20px, 5vw, 96px) clamp(48px, 6vw, 96px);
  }

  .main__inner {
    max-width: 680px;
    margin: 0 auto;
  }

  .progress {
    position: sticky;
    top: 0;
    z-index: 5;
    margin: 0 0 clamp(28px, 4vw, 48px);
    padding: 16px 0 14px;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(8px);
  }

  .progress__bar {
    height: 4px;
    overflow: hidden;
    border-radius: 999px;
    background: #eee;
  }

  .progress__bar span {
    display: block;
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: var(--red);
    transition: width 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .progress__steps {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    font-size: 12px;
    color: #9a9a9a;
  }

  .progress__steps li {
    display: flex;
    align-items: center;
    gap: 6px;
    transition: color 0.3s ease;
  }

  .progress__steps span {
    font-family: var(--font-head);
  }

  .progress__steps li.is-done {
    color: var(--charcoal);
    font-weight: 600;
  }

  .progress__steps li.is-done span {
    color: var(--red);
  }

  .head__eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 12px;
    font-family: var(--font-head);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--red);
  }

  .head__eyebrow span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--red);
  }

  .head__title {
    margin: 0;
    font-size: clamp(34px, 3.6vw, 58px);
    line-height: 0.95;
  }

  .head__text {
    margin: 12px 0 0;
    font-size: 15px;
    color: #6d6d6d;
  }

  .req {
    color: var(--red);
  }

  .opt {
    margin-left: 4px;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: #9a9a9a;
  }

  /* ---- Sections ---- */

  .form {
    display: grid;
    gap: clamp(32px, 4vw, 48px);
    margin-top: clamp(28px, 3.4vw, 44px);
  }

  .sec {
    display: grid;
    gap: 18px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .sec__title {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    margin-bottom: 4px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(51, 51, 51, 0.12);
    font-family: var(--font-head);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .sec__title span {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #f1f1f1;
    font-size: 12px;
    color: #8a8a8a;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .sec.is-done .sec__title span {
    background: var(--red);
    color: var(--white);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .field {
    display: grid;
    gap: 8px;
  }

  .field--wide {
    grid-column: 1 / -1;
  }

  .field__label {
    margin: 0;
    font-family: var(--font-head);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .field input,
  .field select,
  .field textarea,
  .phone {
    width: 100%;
    border: 1.5px solid #e2e2e2;
    border-radius: 12px;
    background: var(--white);
    font: inherit;
    font-size: 16px;
    color: var(--charcoal);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .field input,
  .field select,
  .field textarea {
    padding: 14px 16px;
  }

  .field select {
    appearance: none;
    padding-right: 40px;
    background-image: linear-gradient(45deg, transparent 50%, #777 50%), linear-gradient(135deg, #777 50%, transparent 50%);
    background-position: calc(100% - 20px) 52%, calc(100% - 14px) 52%;
    background-size: 6px 6px;
    background-repeat: no-repeat;
  }

  .field textarea {
    resize: vertical;
    line-height: 1.6;
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: #b5b5b5;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus,
  .phone:focus-within {
    outline: none;
    border-color: var(--charcoal);
    box-shadow: 0 0 0 4px rgba(189, 47, 47, 0.12);
  }

  .phone {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    overflow: hidden;
  }


  .phone input {
    border: 0;
    border-radius: 0;
    box-shadow: none !important;
  }

  .is-invalid input,
  .is-invalid select,
  .phone.is-invalid,
  .choices.is-invalid .choice span,
  .drop.is-invalid .drop__zone {
    border-color: var(--red) !important;
    background-color: rgba(189, 47, 47, 0.03);
  }

  /* ---- Choices ---- */

  .choices {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .choice input {
    position: absolute;
    opacity: 0;
  }

  .choice span {
    display: grid;
    gap: 4px;
    height: 100%;
    padding: 16px 18px 16px 50px;
    border: 1.5px solid #e2e2e2;
    border-radius: 12px;
    font-size: 13px;
    color: #6d6d6d;
    cursor: pointer;
    position: relative;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .choice strong {
    font-family: var(--font-head);
    font-size: 17px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--charcoal);
  }

  .choice span::before {
    content: '';
    position: absolute;
    left: 18px;
    top: 19px;
    width: 18px;
    height: 18px;
    border: 2px solid #c9c9c9;
    border-radius: 50%;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .choice:hover span {
    border-color: #bdbdbd;
  }

  .choice input:checked + span {
    border-color: var(--red);
    background: rgba(189, 47, 47, 0.04);
  }

  .choice input:checked + span::before {
    border-color: var(--red);
    box-shadow: inset 0 0 0 4px var(--white), inset 0 0 0 10px var(--red);
  }

  .choice input:focus-visible + span {
    outline: 2px solid var(--red);
    outline-offset: 2px;
  }

  /* ---- Uploads ---- */

  .drop {
    position: relative;
  }

  .drop__input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .drop__zone {
    display: grid;
    justify-items: center;
    gap: 6px;
    padding: 30px 20px;
    border: 2px dashed #dcdcdc;
    border-radius: 14px;
    background: #fbfbfb;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .drop--small .drop__zone {
    padding: 16px 20px;
  }

  .drop__zone:hover,
  .drop.is-over .drop__zone,
  .drop__input:focus-visible + .drop__zone {
    border-color: var(--red);
    background: rgba(189, 47, 47, 0.04);
  }

  .drop.has-file .drop__zone {
    border-style: solid;
    border-color: var(--charcoal);
    background: var(--white);
  }

  .drop__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: 4px;
    border-radius: 50%;
    background: rgba(189, 47, 47, 0.1);
  }

  .drop__icon svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: var(--red);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .drop.has-file .drop__icon {
    background: var(--red);
  }

  .drop.has-file .drop__icon svg {
    stroke: var(--white);
  }

  .drop__title {
    font-family: var(--font-head);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .drop__text {
    font-size: 13px;
    line-height: 1.55;
    color: #7a7a7a;
  }

  .drop.has-file .drop__text {
    color: var(--charcoal);
    font-weight: 600;
  }

  .consent {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
    padding: 16px;
    border-radius: 12px;
    background: #f6f6f6;
    font-size: 14px;
    line-height: 1.55;
    color: #555;
  }

  .consent input {
    width: 20px;
    height: 20px;
    accent-color: var(--red);
  }

  .consent a {
    text-decoration: underline;
  }

  .consent.is-invalid {
    outline: 1.5px solid var(--red);
  }

  /* ---- Submit ---- */

  .submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid rgba(51, 51, 51, 0.12);
  }

  .submit__status {
    flex: 1 1 260px;
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
  }

  .submit__status.is-err {
    color: var(--red);
  }

  .submit__btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 17px 30px;
    border: 0;
    border-radius: 12px;
    background: var(--red);
    color: var(--white);
    font-family: var(--font-head);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.34s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
  }

  .submit__btn:hover {
    background: #a82727;
    box-shadow: 0 14px 30px -14px rgba(189, 47, 47, 0.8);
    transform: translateY(-2px);
  }

  .submit__btn[disabled] {
    opacity: 0.6;
    cursor: progress;
  }

  .eq {
    margin: 0;
    font-size: 12px;
    line-height: 1.65;
    color: #9a9a9a;
  }

  /* ---- Done ---- */

  .done {
    display: grid;
    justify-items: start;
    gap: 16px;
    padding-top: clamp(24px, 6vh, 80px);
    outline: none;
    animation: rise 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  /* hidden must win over display: grid above. */
  .done[hidden] {
    display: none;
  }

  .done__icon {
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 0 0 rgba(189, 47, 47, 0.45);
    animation:
      pop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both,
      pulse 1.6s ease-out 0.6s;
  }

  .done__icon svg {
    width: 84px;
    height: 84px;
    fill: none;
    stroke: var(--white);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .done__ring {
    stroke-width: 2;
    stroke: rgba(255, 255, 255, 0.35);
    stroke-dasharray: 151;
    stroke-dashoffset: 151;
    animation: draw 0.7s cubic-bezier(0.65, 0, 0.35, 1) 0.2s forwards;
  }

  .done__tick {
    stroke-width: 4;
    stroke-dasharray: 36;
    stroke-dashoffset: 36;
    animation: draw 0.45s cubic-bezier(0.65, 0, 0.35, 1) 0.55s forwards;
  }

  @keyframes pop {
    from {
      transform: scale(0.4);
      opacity: 0;
    }
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes pulse {
    to {
      box-shadow: 0 0 0 26px rgba(189, 47, 47, 0);
    }
  }

  .done > :not(.done__icon) {
    animation: rise 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .done > :nth-child(2) { animation-delay: 0.7s; }
  .done > :nth-child(3) { animation-delay: 0.8s; }
  .done > :nth-child(4) { animation-delay: 0.9s; }

  .done__title {
    margin: 0;
    font-size: clamp(36px, 4vw, 64px);
    line-height: 0.95;
  }

  .done__text {
    margin: 0;
    max-width: 48ch;
    font-size: 17px;
    line-height: 1.7;
    color: #555;
  }

  .done__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: 8px;
  }

  .done__link {
    font-family: var(--font-head);
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-color: var(--red);
    text-underline-offset: 5px;
  }

  /* ================= Responsive ================= */

  @media (max-width: 960px) {
    .shell {
      grid-template-columns: minmax(0, 1fr);
    }

    .panel__inner {
      position: static;
      min-height: 0;
      max-height: none;
      overflow: visible;
    }

    .progress__steps li {
      font-size: 0;
    }

    .progress__steps span {
      font-size: 12px;
    }
  }

  @media (max-width: 560px) {
    .grid,
    .choices {
      grid-template-columns: minmax(0, 1fr);
    }

    .submit__btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  if (form) {
    const secs = [...form.querySelectorAll<HTMLElement>('[data-step]')];
    const dots = [...document.querySelectorAll<HTMLElement>('[data-step-dot]')];
    const bar = document.querySelector<HTMLElement>('[data-progress]');
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const MAX = 10 * 1024 * 1024;
    const okFile = (f?: File) => !!f && f.size <= MAX && /\.(pdf|docx?)$/i.test(f.name);

    // A section is complete when every required control in it is valid.
    const complete = (sec: HTMLElement) =>
      [...sec.querySelectorAll<HTMLInputElement>('[required]')].every((el) =>
        el.type === 'file' ? okFile(el.files?.[0]) : el.checkValidity()
      );

    const refresh = () => {
      let done = 0;
      secs.forEach((sec, i) => {
        const ok = complete(sec);
        sec.classList.toggle('is-done', ok);
        dots[i]?.classList.toggle('is-done', ok);
        if (ok) done++;
      });
      if (bar) bar.style.width = `${(done / secs.length) * 100}%`;
    };
    form.addEventListener('input', refresh);
    form.addEventListener('change', refresh);

    // Uploads: drag and drop + file name display.
    form.querySelectorAll<HTMLElement>('[data-drop]').forEach((drop) => {
      const input = drop.querySelector<HTMLInputElement>('input[type=file]')!;
      const label = drop.querySelector<HTMLElement>('[data-file-name]')!;
      const hint = label.innerHTML;
      const show = () => {
        const f = input.files?.[0];
        drop.classList.toggle('has-file', !!f);
        if (f) label.textContent = `${f.name} · ${(f.size / 1024 / 1024).toFixed(1)} MB`;
        else label.innerHTML = hint;
        drop.classList.remove('is-invalid');
        refresh();
      };
      input.addEventListener('change', show);
      ['dragenter', 'dragover'].forEach((ev) =>
        drop.addEventListener(ev, (e) => {
          e.preventDefault();
          drop.classList.add('is-over');
        })
      );
      ['dragleave', 'drop'].forEach((ev) => drop.addEventListener(ev, () => drop.classList.remove('is-over')));
      drop.addEventListener('drop', (e) => {
        e.preventDefault();
        if (e.dataTransfer?.files.length) {
          input.files = e.dataTransfer.files;
          show();
        }
      });
    });

    const say = (msg: string, err = false) => {
      status.textContent = msg;
      status.classList.toggle('is-err', err);
    };

    const validate = () => {
      let first: HTMLElement | null = null;
      const mark = (el: HTMLElement, bad: boolean) => {
        el.classList.toggle('is-invalid', bad);
        if (bad && !first) first = el;
      };
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('.field [required], .phone [required]').forEach((el) => {
        mark((el.closest('.phone') as HTMLElement) ?? (el.closest('.field') as HTMLElement), !el.checkValidity());
      });
      const radio = form.querySelector<HTMLInputElement>('input[name="work_eligible"]')!;
      mark(form.querySelector('.choices')!, !radio.checkValidity());
      const resume = form.querySelector<HTMLInputElement>('#resume')!;
      mark(resume.closest('[data-drop]') as HTMLElement, !okFile(resume.files?.[0]));
      const cover = form.querySelector<HTMLInputElement>('#cover')!;
      if (cover.files?.[0]) mark(cover.closest('[data-drop]') as HTMLElement, !okFile(cover.files[0]));
      const consent = form.querySelector<HTMLInputElement>('input[name="consent"]')!;
      mark(consent.closest('.consent') as HTMLElement, !consent.checked);
      if (first) {
        say('Please complete the highlighted fields. Files must be PDF, DOC or DOCX under 10 MB.', true);
        (first as HTMLElement).scrollIntoView({ block: 'center', behavior: 'smooth' });
        return false;
      }
      return true;
    };

    // Clear a field's error as soon as it's fixed.
    // Drop the error summary once the applicant starts fixing things.
    const clearErr = () => {
      if (status.classList.contains('is-err')) {
        status.textContent = '';
        status.classList.remove('is-err');
      }
    };
    form.addEventListener('input', clearErr);
    form.addEventListener('change', clearErr);

    form.addEventListener('input', (e) => {
      const el = e.target as HTMLElement;
      const box = el.closest('.is-invalid');
      if (box && (el as HTMLInputElement).checkValidity?.()) box.classList.remove('is-invalid');
    });
    form.addEventListener('change', (e) => {
      const el = e.target as HTMLInputElement;
      if (el.name === 'work_eligible') form.querySelector('.choices')?.classList.remove('is-invalid');
      if (el.name === 'consent' && el.checked) el.closest('.consent')?.classList.remove('is-invalid');
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validate()) return;
      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        say('Online applications are almost ready. For now, please email your resume to info@infocusfilmschool.com.', true);
        return;
      }
      submit.disabled = true;
      say('Sending your application…');
      try {
        const res = await fetch(endpoint, { method: 'POST', body: new FormData(form) });
        if (!res.ok) throw new Error(String(res.status));
        document.querySelector<HTMLElement>('[data-view="form"]')!.hidden = true;
        document.querySelector<HTMLElement>('.progress')!.hidden = true;
        const done = document.querySelector<HTMLElement>('[data-view="done"]')!;
        done.hidden = false;
        done.focus();
        window.scrollTo({ top: 0 });
      } catch {
        say('Something went wrong sending your application. Please try again, or email info@infocusfilmschool.com.', true);
      } finally {
        submit.disabled = false;
      }
    });

    refresh();
  }

</script>
