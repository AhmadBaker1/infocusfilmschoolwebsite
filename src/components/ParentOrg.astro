---
// "Proudly part of MCG Career College" card. Used on the homepage and About
// page. The ridge line echoes the mountain in MCG's mark.
---

<section class="fam" aria-labelledby="fam-title">
  <div class="fam__card">
    <span class="fam__corner fam__corner--tl" aria-hidden="true"></span>
    <span class="fam__corner fam__corner--tr" aria-hidden="true"></span>
    <span class="fam__corner fam__corner--bl" aria-hidden="true"></span>
    <span class="fam__corner fam__corner--br" aria-hidden="true"></span>

    <svg class="fam__ridge" viewBox="0 0 1200 220" preserveAspectRatio="none" aria-hidden="true">
      <path class="fam__ridge-far" d="M0 170 L110 120 L190 145 L300 80 L380 130 L470 95 L560 150 L660 70 L760 128 L850 100 L950 150 L1060 90 L1200 140" />
      <path class="fam__ridge-near" d="M0 200 L140 150 L230 180 L360 120 L450 170 L560 140 L680 185 L800 135 L900 175 L1030 140 L1200 190" />
    </svg>

    <div class="fam__inner">
      <div class="fam__copy">
        <p class="fam__eyebrow"><span aria-hidden="true"></span>Our family of schools</p>
        <h2 id="fam-title" class="fam__title">Proudly part of<br /><em>MCG Career College</em></h2>
        <p class="fam__text">
          InFocus Film School is proud to be part of the MCG Career College family of schools.
          Our founding mission of accelerated, hands-on education in film and entertainment arts
          continues, now supported by a wider network committed to career-focused learning and
          student success.
        </p>
        <a class="fam__link" href="https://mcgcollege.com/" target="_blank" rel="noopener">
          Visit MCG Career College <span aria-hidden="true">↗</span>
        </a>
      </div>

      <a class="fam__logo" href="https://mcgcollege.com/" target="_blank" rel="noopener" aria-label="MCG Career College">
        <img src="/images/mcg-logo-white.png" alt="MCG Career College" width="656" height="238" loading="lazy" decoding="async" />
      </a>
    </div>
  </div>
</section>

<style>
  .fam {
    background: var(--white);
  }

  .fam__card {
    --inset: clamp(14px, 1.6vw, 24px);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(64px, 7vw, 120px) var(--gutter) clamp(96px, 10vw, 160px);
    background:
      radial-gradient(55% 90% at 100% 0%, rgba(189, 47, 47, 0.32), transparent 65%),
      radial-gradient(50% 90% at 0% 100%, rgba(34, 68, 102, 0.6), transparent 70%),
      var(--charcoal);
    color: var(--white);
  }

  .fam__corner {
    position: absolute;
    width: 22px;
    aspect-ratio: 1;
    border: 0 solid rgba(255, 255, 255, 0.45);
  }

  .fam__corner--tl { top: var(--inset); left: var(--inset); border-top-width: 2px; border-left-width: 2px; }
  .fam__corner--tr { top: var(--inset); right: var(--inset); border-top-width: 2px; border-right-width: 2px; }
  .fam__corner--bl { bottom: var(--inset); left: var(--inset); border-bottom-width: 2px; border-left-width: 2px; }
  .fam__corner--br { bottom: var(--inset); right: var(--inset); border-bottom-width: 2px; border-right-width: 2px; }

  .fam__ridge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: -1;
    width: 100%;
    height: clamp(70px, 9vw, 130px);
  }

  .fam__ridge path {
    fill: none;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .fam__ridge-far {
    stroke: rgba(255, 255, 255, 0.12);
    stroke-width: 1.2;
  }

  .fam__ridge-near {
    stroke: rgba(255, 255, 255, 0.28);
    stroke-width: 1.4;
  }

  .fam__inner {
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }

  .fam__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 16px;
    font-family: var(--font-head);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--red);
  }

  .fam__eyebrow span {
    width: 36px;
    height: 2px;
    background: var(--red);
  }

  .fam__title {
    margin: 0;
    font-size: clamp(32px, 3.6vw, 56px);
    line-height: 0.98;
  }

  .fam__title em {
    font-style: normal;
    color: var(--red);
  }

  .fam__text {
    margin: clamp(16px, 1.8vw, 24px) 0 0;
    max-width: 52ch;
    font-size: clamp(15px, 1.08vw, 17px);
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.75);
  }

  .fam__link {
    display: inline-flex;
    gap: 10px;
    margin-top: clamp(22px, 2.4vw, 30px);
    padding-bottom: 6px;
    border-bottom: 2px solid var(--red);
    font-family: var(--font-head);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  .fam__link:hover {
    color: var(--red);
  }

  .fam__logo {
    justify-self: center;
    display: grid;
    place-items: center;
    width: 100%;
    max-width: 320px;
    padding: clamp(18px, 2vw, 28px);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
  }

  .fam__logo:hover {
    transform: scale(1.03);
  }

  .fam__logo img {
    width: 100%;
    height: auto;
  }

  @media (max-width: 820px) {
    .fam__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .fam__logo {
      order: -1;
      justify-self: start;
      max-width: 220px;
      padding: 0;
    }
  }
</style>
