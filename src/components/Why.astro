---
// Layout mirrors the reference: photo left with the brand mark overlapping its
// bottom-left corner, and right-hand copy with highlighted words in the
// headline over a 2x2 feature grid.
const features = [
  {
    title: 'Hands-On Learning',
    text: 'Project-based courses with a focus on building a strong portfolio.',
    // Clapperboard
    path: 'M3 8h18v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8Zm0 0 1.2-3.6a1 1 0 0 1 1.2-.66l13.4 2.9a1 1 0 0 1 .77 1.2L19.4 8M8.4 4.6 6.9 8m6-2.6L11.4 8m6-1.6L16 8',
  },
  {
    title: 'Industry Instructors',
    text: 'Industry-professional instructors mentor students through interactive classes.',
    // Mentor
    path: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-8 8a8 8 0 0 1 16 0',
  },
  {
    title: 'A Real Portfolio',
    text: 'You leave with a body of work, not just a credential.',
    // Film strip
    path: 'M3 5h18v14H3V5Zm0 4h4m-4 3h4m-4 3h4m10-6h4m-4 3h4m-4 3h4M9 5v14',
  },
  {
    title: 'Creative Autonomy',
    text: 'Realize your own artistic vision and keep creative control of your work.',
    // Aperture
    path: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm-8.2-4.2h11m-6.4-11.6 5.5 9.6m2.9-3.6h-11m6.4 11.6-5.5-9.6',
  },
];
---

<section class="why" id="why">
  <div class="why__inner">
    <figure class="why__media">
      <svg class="why__mark" viewBox="0 0 100 100" fill="none" aria-hidden="true">
        <rect x="4.4" y="4.4" width="91.2" height="91.2" stroke="var(--red)" stroke-width="8.8" />
        <circle cx="30.25" cy="30.69" r="11.55" fill="var(--red)" />
      </svg>

      <div class="why__frame">
        <img
          src="/images/about-3.jpg"
          alt="Two students building a camera rig in the InFocus studio"
          width="1200"
          height="800"
          loading="lazy"
          decoding="async"
        />
      </div>
    </figure>

    <div class="why__body">
      <p class="eyebrow"><span aria-hidden="true"></span>Why InFocus</p>

      <h2 class="why__title">
        <span class="line">Accelerated. <mark>Hands-On.</mark></span>
        <span class="line"><mark>Industry-Led.</mark></span>
      </h2>

      <p class="why__lede">
        InFocus Film School provides a superior education through accelerated, hands-on learning.
        Our instructors are working professionals, and every course is built around making work you
        can show.
      </p>

      <ul class="feats">
        {
          features.map((f) => (
            <li>
              <span class="feats__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                     stroke-linecap="round" stroke-linejoin="round">
                  <path d={f.path} />
                </svg>
              </span>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .why {
    background: var(--white);
    color: var(--charcoal);
    padding: clamp(56px, 7vw, 118px) var(--gutter);
  }

  .why__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(36px, 5.5vw, 96px);
    align-items: center;
    max-width: 1600px;
    margin: 0 auto;
  }

  /* ---- Photo ---- */

  .why__media {
    /* Shared by both mark copies so they land on the same point. */
    --hang: clamp(26px, 3vw, 46px);
    --mark: clamp(92px, 10vw, 156px);
    position: relative;
    margin: 0;
    /* Clearance at the bottom-left for the mark to hang past the frame. */
    padding: 0 0 var(--hang) var(--hang);
  }

  .why__frame {
    position: relative;
    z-index: 1;
    border-radius: clamp(22px, 2.6vw, 42px);
    /* Clips the white copy to the photo. */
    overflow: hidden;
  }

  .why__frame img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 52% 45%;
  }

  .why__mark {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 2;
    width: var(--mark);
    height: auto;
  }

  /* ---- Copy ---- */

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 clamp(14px, 1.6vw, 22px);
    font-family: var(--font-head);
    font-size: clamp(12px, 0.92vw, 15px);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--red);
  }

  /* Small filled square, as in the reference. */
  .eyebrow span {
    width: 13px;
    height: 13px;
    background: var(--red);
  }

  .why__title {
    margin: 0 0 clamp(18px, 2vw, 30px);
    font-size: clamp(28px, 3.5vw, 62px);
    font-weight: 600;
    line-height: 1.28;
  }

  .why__title .line {
    display: block;
  }

  /* Highlighted words sit in a red block. Box-decoration-break keeps the
     padding intact if a highlight ever wraps. */
  .why__title mark {
    background: var(--red);
    color: var(--white);
    padding: 0.06em 0.3em 0.14em;
    border-radius: 8px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .why__lede {
    margin: 0 0 clamp(28px, 3.4vw, 52px);
    max-width: 62ch;
    color: #4f4f4f;
    font-size: clamp(15px, 1.08vw, 18px);
    line-height: 1.65;
  }

  /* ---- Feature grid ---- */

  .feats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 48px) clamp(24px, 3.4vw, 60px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .feats__icon {
    display: block;
    width: 42px;
    margin-bottom: 16px;
    padding-bottom: 12px;
    /* Rule under the icon, as in the reference. */
    border-bottom: 2px solid var(--red);
    color: var(--red);
  }

  .feats__icon svg {
    display: block;
    width: 34px;
    height: 34px;
  }

  .feats h3 {
    margin: 0 0 7px;
    font-size: clamp(16px, 1.25vw, 22px);
    font-weight: 600;
    line-height: 1.15;
  }

  .feats p {
    margin: 0;
    max-width: 30ch;
    color: #5c5c5c;
    font-size: clamp(13px, 0.95vw, 16px);
    line-height: 1.55;
  }

  @media (max-width: 980px) {
    .why__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(32px, 5vw, 48px);
    }

    .why__frame img {
      aspect-ratio: 16 / 10;
    }
  }

  @media (max-width: 560px) {
    .feats {
      grid-template-columns: minmax(0, 1fr);
    }

    .feats p {
      max-width: none;
    }
  }
</style>
