---
// Both marks are transparent PNGs and full-colour, so they sit on the light
// background as supplied — no recolouring, which these bodies generally
// prohibit anyway.
const marks = [
  {
    src: '/images/ptiru-logo.png',
    alt: 'Designated — B.C. Private Training Institutions Regulatory Unit',
    w: 647,
    h: 646,
  },
  {
    src: '/images/EQA_RGB_pos.png',
    alt: 'Education Quality Assurance — British Columbia',
    w: 263,
    h: 263,
  },
];
---

<section class="accred" id="accreditation">
  <div class="accred__inner">
    <div class="accred__copy">
      <p class="eyebrow">Accredited &amp; Licensed</p>
      <h2 class="accred__title">
        Recognized by the <em>bodies that matter</em> in British Columbia.
      </h2>
      <p class="accred__text">
        InFocus Film School is designated and quality-assured in British Columbia.
      </p>
    </div>

    <ul class="marks">
      {
        marks.map((m) => (
          <li>
            <img src={m.src} alt={m.alt} width={m.w} height={m.h} loading="lazy" decoding="async" />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* A utility strip, not a feature section — shallow padding keeps the
     band horizontal rather than letting it grow into a block. */
  .accred {
    background: var(--white);
    color: var(--charcoal);
    padding: clamp(30px, 3.4vw, 58px) var(--gutter);
    border-top: 1px solid rgba(51, 51, 51, 0.12);
  }

  .accred__inner {
    display: grid;
    /* Copy gets less, marks get more, so the row can breathe. */
    grid-template-columns: minmax(0, 0.74fr) minmax(0, 1.26fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: center;
    max-width: 1600px;
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 clamp(8px, 0.9vw, 13px);
    font-family: var(--font-head);
    font-size: clamp(10px, 0.72vw, 12px);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--red);
  }

  .accred__title {
    margin: 0 0 clamp(9px, 1vw, 15px);
    max-width: 26ch;
    font-size: clamp(18px, 1.85vw, 32px);
    font-weight: 600;
    line-height: 1.12;
  }

  /* Second colour picks out the phrase, as in the reference. */
  .accred__title em {
    font-style: normal;
    color: var(--red);
  }

  .accred__text {
    margin: 0;
    max-width: 42ch;
    color: #6a6a6a;
    font-size: clamp(12px, 0.85vw, 15px);
    line-height: 1.5;
  }

  /* Even columns with hairline rules between, so the row reads as a set
     rather than logos floating at arbitrary distances. */
  .marks {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Equal columns so the marks distribute across the row instead of
     clustering — the marks are small enough now that it reads as spread
     rather than flung apart. */
  .marks li {
    flex: 1;
    display: grid;
    place-items: center;
    padding: clamp(4px, 0.6vw, 10px) clamp(12px, 1.8vw, 32px);
  }

  .marks li + li {
    border-left: 1px solid rgba(51, 51, 51, 0.14);
  }

  .marks img {
    height: clamp(50px, 4.6vw, 82px);
    width: auto;
    max-width: 100%;
  }

  @media (max-width: 900px) {
    .accred__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(28px, 5vw, 44px);
    }

    .accred__title,
    .accred__text {
      max-width: none;
    }

    .marks {
      justify-content: flex-start;
    }

    .marks li {
      flex: 0 1 auto;
      padding-left: 0;
    }

    .marks li + li {
      padding-left: clamp(18px, 5vw, 40px);
      margin-left: clamp(18px, 5vw, 40px);
    }
  }
</style>
