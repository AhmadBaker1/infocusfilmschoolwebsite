---
// Testimonial reel. The active voice's card stretches open while the others
// squeeze to slivers, and its quote takes over the copy column.
// Portraits are the 4:5 crops in /public/images/leadership (shared with the
// Leadership page). Quotes are drawn from each person's bio.
const voices = [
  {
    name: 'Monika Chhabra Gupta',
    role: 'President & CEO',
    img: '/images/leadership/monika-gupta.jpg',
    pos: '50% 28%',
    quote:
      'At InFocus, we bring a builder’s eye to the creative industries, turning raw talent into working careers. See the potential in people, then build the pathway to it.',
  },
  {
    name: 'Dmetri Berko',
    role: 'Vice President & Dean',
    img: '/images/leadership/dmetri-berko.jpg',
    pos: '45% 22%',
    quote:
      'Every program we run has to meet the highest standards of quality and industry relevance, and every student should feel genuinely cared for along the way.',
  },
  {
    name: 'Nada Jankowski',
    role: 'Campus Director',
    img: '/images/leadership/nada-jankowski.jpg',
    pos: '50% 30%',
    quote:
      'We lead the campus with precision and purpose: operational excellence in service of student success, and a real appreciation for the art our students are here to make.',
  },
];

const initials = (n: string) =>
  n
    .split(/\s+/)
    .map((w) => w[0])
    .join('')
    .slice(0, 2);
---

<section class="voices" id="voices" aria-roledescription="carousel" aria-label="Voices of InFocus">
  <div class="voices__inner">
    <div class="voices__copy">
      <p class="eyebrow"><span aria-hidden="true"></span>Leadership</p>
      <h2 class="voices__title">We Are InFocus</h2>

      <div class="quotes" aria-live="polite">
        {
          voices.map((v, i) => (
            <figure class:list={['quote', { 'is-active': i === 0 }]} data-quote={i} aria-hidden={i !== 0 ? 'true' : undefined}>
              <blockquote>
                <p>{v.quote}</p>
              </blockquote>
              <figcaption>
                <span class="quote__name">{v.name}</span>
                <span class="quote__role">{v.role}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>


      <a class="voices__link" href="/leadership">
        Meet our leadership team
        <span class="arw arw--r voices__arrow" aria-hidden="true"></span>
      </a>
    </div>

    <ul class="stage">
      {
        voices.map((v, i) => (
          <li class:list={['card', { 'is-active': i === 0 }]} data-card={i} style={`--i:${i}`}>
            <button class="card__hit" type="button" aria-label={`Show ${v.name}`} data-go={i} />
            {v.img ? (
              <img
                class="card__img"
                src={v.img}
                alt={v.name}
                style={`object-position:${v.pos}`}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class="card__ph" aria-hidden="true">
                <span>{initials(v.name)}</span>
              </span>
            )}
            <span class="card__scrim" aria-hidden="true" />
            <span class="card__cap" aria-hidden="true">
              <span class="card__name">{v.name}</span>
              <span class="card__role">{v.role}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .voices {
    --ease: cubic-bezier(0.65, 0, 0.35, 1);
    --out: cubic-bezier(0.16, 1, 0.3, 1);
    background: var(--white);
    color: var(--charcoal);
    padding: clamp(56px, 7vw, 118px) var(--gutter);
  }

  .voices__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(34px, 5vw, 96px);
    align-items: center;
    max-width: 1600px;
    margin: 0 auto;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 clamp(18px, 2vw, 32px);
    font-family: var(--font-head);
    font-size: clamp(11px, 0.8vw, 13px);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--red);
  }

  .eyebrow span {
    width: clamp(24px, 2.6vw, 44px);
    height: 2px;
    background: var(--red);
  }

  .voices__title {
    margin: 0 0 clamp(26px, 2.8vw, 46px);
    font-size: clamp(30px, 3.4vw, 60px);
    font-weight: 600;
    line-height: 1;
  }

  /* ---- Quotes: stacked in one grid cell so the column holds the
     height of the longest and never jumps as they swap. ---- */

  .quotes {
    display: grid;
  }

  /* Each quote fills the shared cell and pins its caption to the bottom,
     so the name sits in the same spot whatever the quote's length. */
  .quote {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(18px);
    transition:
      opacity 0.5s var(--out),
      transform 0.5s var(--out),
      visibility 0s linear 0.5s;
  }

  .quote.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.8s var(--out) 0.35s,
      transform 0.8s var(--out) 0.35s,
      visibility 0s;
  }

  .quote blockquote {
    margin: 0 0 clamp(20px, 2.2vw, 34px);
  }

  .quote p {
    margin: 0;
    max-width: 26ch;
    font-family: var(--font-quote);
    font-weight: 500;
    font-size: clamp(21px, 1.95vw, 34px);
    line-height: 1.34;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }

  .quote figcaption {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: auto;
  }

  .quote figcaption::before {
    content: '';
    width: clamp(20px, 2vw, 32px);
    height: 2px;
    background: var(--red);
  }

  .quote__name {
    font-family: var(--font-head);
    font-size: clamp(14px, 1.1vw, 19px);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .quote__role {
    font-size: clamp(12px, 0.85vw, 14px);
    color: rgba(51, 51, 51, 0.6);
  }

  /* ---- Link: a hairline track with a red rule over it. On hover the
     rule wipes out to the right and redraws from the left. ---- */

  .voices__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-top: clamp(36px, 3.8vw, 60px);
    padding-bottom: 12px;
    font-family: var(--font-head);
    font-size: clamp(12px, 0.95vw, 15px);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--charcoal);
    transition: color 0.3s var(--out);
  }

  .voices__link::before,
  .voices__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
  }

  .voices__link::before {
    height: 1px;
    background: rgba(51, 51, 51, 0.16);
  }

  .voices__link::after {
    bottom: -0.5px;
    height: 2px;
    background: var(--red);
    transform-origin: left;
  }

  .voices__link:hover {
    color: var(--red);
  }

  .voices__link:hover::after {
    animation: wipe 0.75s var(--ease);
  }

  @keyframes wipe {
    0% {
      transform: scaleX(1);
      transform-origin: right;
    }
    50% {
      transform: scaleX(0);
      transform-origin: right;
    }
    50.01% {
      transform: scaleX(0);
      transform-origin: left;
    }
    100% {
      transform: scaleX(1);
      transform-origin: left;
    }
  }

  .voices__arrow {
    transition: transform 0.4s var(--out);
  }

  .voices__link:hover .voices__arrow {
    transform: translateX(6px);
  }

  /* ---- Stage: the active card grows, the rest squeeze to slivers. ---- */

  .stage {
    display: flex;
    gap: clamp(10px, 1vw, 16px);
    height: clamp(380px, 36vw, 640px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
    border-radius: 18px;
    background: var(--grey);
    transition: flex-grow 1.1s var(--ease);
  }

  .card.is-active {
    flex-grow: 3.6;
  }

  .card__hit {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    border-radius: inherit;
  }

  .card.is-active .card__hit {
    cursor: default;
  }

  .card__img,
  .card__ph {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.08);
    filter: saturate(0.6);
    transition:
      transform 1.4s var(--ease),
      filter 1.1s var(--ease);
  }

  .card.is-active .card__img,
  .card.is-active .card__ph {
    transform: scale(1);
    filter: none;
  }

  .card:not(.is-active):hover .card__img,
  .card:not(.is-active):hover .card__ph {
    filter: saturate(0.9);
  }

  .card__ph {
    display: grid;
    place-items: center;
    background:
      radial-gradient(120% 80% at 20% 0%, rgba(189, 47, 47, 0.35), transparent 60%),
      linear-gradient(160deg, var(--blue), var(--charcoal));
  }

  .card__ph span {
    font-family: var(--font-accent);
    font-style: italic;
    font-size: clamp(60px, 7vw, 130px);
    color: rgba(255, 255, 255, 0.16);
  }

  .card__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0) 45%);
    opacity: 0.35;
    transition: opacity 0.9s var(--ease);
  }

  .card.is-active .card__scrim {
    opacity: 1;
  }

  .card__cap {
    position: absolute;
    left: clamp(18px, 2vw, 32px);
    right: clamp(18px, 2vw, 32px);
    bottom: clamp(18px, 2vw, 30px);
    display: grid;
    gap: 4px;
    color: var(--white);
    white-space: nowrap;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.4s var(--out),
      transform 0.4s var(--out);
  }

  .card.is-active .card__cap {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.7s var(--out) 0.6s,
      transform 0.7s var(--out) 0.6s;
  }

  .card__name {
    font-family: var(--font-head);
    font-size: clamp(18px, 1.6vw, 28px);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .card__role {
    font-size: clamp(12px, 0.85vw, 14px);
    color: rgba(255, 255, 255, 0.75);
  }

  /* ---- Scroll reveal ---- */

  .voices__copy,
  .card {
    opacity: 0;
    transform: translateY(18px);
  }

  .voices.is-in .voices__copy,
  .voices.is-in .card {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.8s var(--out) calc(var(--i, 0) * 0.08s),
      transform 0.8s var(--out) calc(var(--i, 0) * 0.08s),
      flex-grow 1.1s var(--ease);
  }

  @media (prefers-reduced-motion: reduce) {
    .voices__copy,
    .card {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 1000px) {
    .voices__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .stage {
      order: -1;
      height: clamp(320px, 62vw, 520px);
    }

    .quote p {
      max-width: 30ch;
    }
  }

  @media (max-width: 560px) {
    .card.is-active {
      flex-grow: 5;
    }

    /* The open card is too narrow here for a long name on one line. */
    .card__cap {
      white-space: normal;
    }

    .card__name {
      font-size: 17px;
      line-height: 1.15;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('.voices');

  if (section) {
    const cards = [...section.querySelectorAll<HTMLElement>('[data-card]')];
    const quotes = [...section.querySelectorAll<HTMLElement>('[data-quote]')];
    const HOLD = 7000;
    let current = 0;
    let elapsed = 0;

    const show = (next: number) => {
      current = (next + cards.length) % cards.length;
      cards.forEach((el, i) => el.classList.toggle('is-active', i === current));
      quotes.forEach((el, i) => {
        el.classList.toggle('is-active', i === current);
        el.toggleAttribute('aria-hidden', i !== current);
      });
      elapsed = 0;
    };

    // Hold time only accrues while unpaused, so a pause resumes where it
    // left off. No autoplay for reduced motion — cards still switch on click.
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduced) {
      const STEP = 100;
      setInterval(() => {
        if (section.classList.contains('is-paused')) return;
        elapsed += STEP;
        if (elapsed >= HOLD) show(current + 1);
      }, STEP);
    }

    section.querySelectorAll<HTMLElement>('[data-go]').forEach((el) => {
      el.addEventListener('click', () => {
        const i = Number(el.dataset.go);
        if (i !== current) show(i);
      });
    });

    // Hold still while someone is reading, focused inside, or scrolled away.
    let hovered = false;
    let focused = false;
    let visible = false;
    const sync = () => section.classList.toggle('is-paused', hovered || focused || !visible);
    const stage = section.querySelector('.stage');
    stage?.addEventListener('pointerenter', () => ((hovered = true), sync()));
    stage?.addEventListener('pointerleave', () => ((hovered = false), sync()));
    section.addEventListener('focusin', (e) => {
      focused = (e.target as HTMLElement).matches(':focus-visible');
      sync();
    });
    section.addEventListener('focusout', () => ((focused = false), sync()));

    if (!window.IntersectionObserver) {
      section.classList.add('is-in');
      visible = true;
    } else {
      new IntersectionObserver(
        ([entry]) => {
          visible = entry.isIntersecting;
          if (visible) section.classList.add('is-in');
          sync();
        },
        { threshold: 0.25 }
      ).observe(section);
    }
    sync();
  }
</script>
