---
// White background is required here, not chosen: the Yorkville asset is an
// opaque JPG on white, so it shows a white box on any tinted surface.
---

<section class="partner" id="partnership">
  <div class="partner__inner">
    <div class="partner__copy">
      <p class="eyebrow"><span aria-hidden="true"></span>Our Partnership</p>

      <h2 class="partner__title">A Degree Pathway with Yorkville University</h2>

      <p class="partner__text">
        InFocus Film School is proud to announce a partnership with Yorkville University to offer an
        educational pathway for graduates of the Film Production Program. This pathway will allow
        Film Production graduates to earn a Bachelor’s Degree in Creative Arts in as little as 15
        months.
      </p>
    </div>

    <aside class="partner__card">
      {/* Trimmed to its ink — the supplied file carries 32px of white
          padding, which pushed the logo out of line with the stat below. */}
      <img
        class="partner__logo"
        src="/images/logo-yorkville.jpg"
        alt="Yorkville University"
        width="746"
        height="161"
        loading="lazy"
        decoding="async"
      />

      <div class="stat">
        <span class="stat__num">15</span>
        <span class="stat__unit">Months</span>
        <span class="stat__label">to a Bachelor’s Degree in Creative Arts</span>
      </div>
    </aside>
  </div>
</section>

<style>
  .partner {
    background: var(--white);
    color: var(--charcoal);
    padding: clamp(56px, 7vw, 118px) var(--gutter);
  }

  .partner__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(34px, 5vw, 88px);
    align-items: center;
    max-width: 1600px;
    margin: 0 auto;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 clamp(12px, 1.3vw, 20px);
    font-family: var(--font-head);
    font-size: clamp(11px, 0.8vw, 13px);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--red);
  }

  .eyebrow span {
    width: clamp(24px, 2.6vw, 44px);
    height: 2px;
    background: var(--red);
  }

  .partner__title {
    margin: 0 0 clamp(16px, 1.8vw, 28px);
    max-width: 18ch;
    font-size: clamp(28px, 3.4vw, 58px);
    font-weight: 600;
    line-height: 1.04;
  }

  .partner__text {
    margin: 0;
    max-width: 58ch;
    color: #5a5a5a;
    font-size: clamp(15px, 1.08vw, 18px);
    line-height: 1.62;
  }

  /* The logo sits directly on the page white so its own white background
     disappears — no card tint behind it. */
  .partner__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(24px, 3vw, 44px);
    padding-left: clamp(0px, 2vw, 40px);
    border-left: 1px solid rgba(51, 51, 51, 0.14);
  }

  .partner__logo {
    width: clamp(220px, 22vw, 360px);
    height: auto;
  }

  /* max-content + justify-content:start keeps the number and unit tight
     together; `auto` tracks stretch to the width of the label below. */
  .stat {
    display: grid;
    grid-template-columns: max-content max-content;
    justify-content: start;
    align-items: baseline;
    column-gap: 14px;
  }

  .stat__num {
    font-family: var(--font-head);
    font-size: clamp(46px, 5.4vw, 92px);
    font-weight: 600;
    line-height: 0.9;
    color: var(--red);
  }

  .stat__unit {
    font-family: var(--font-head);
    font-size: clamp(16px, 1.5vw, 26px);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .stat__label {
    grid-column: 1 / -1;
    margin-top: 10px;
    max-width: 26ch;
    color: #6a6a6a;
    font-size: clamp(13px, 0.95vw, 15px);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .partner__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(30px, 5vw, 48px);
    }

    .partner__title,
    .partner__text {
      max-width: none;
    }

    .partner__card {
      padding-left: 0;
      padding-top: clamp(26px, 4vw, 40px);
      border-left: 0;
      border-top: 1px solid rgba(51, 51, 51, 0.14);
    }
  }
</style>
