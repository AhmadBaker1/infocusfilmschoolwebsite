---
// Hero copy lives here so it can be reworded without touching layout.
// Left to right. `pos` is object-position — these are cropped hard to portrait,
// so each one is nudged to keep its subject off the crop edge.
const panels = [
  {
    src: '/images/herobg-1.jpg',
    alt: 'Instructor reading through a script on set beside a lighting stand and monitor',
    w: 1536,
    h: 2048,
    pos: '50% 38%',
  },
  {
    src: '/images/herobg-2.jpg',
    alt: 'Camera operator framing a shot on a cinema rig during an interior shoot',
    w: 4864,
    h: 3648,
    pos: '42% 50%',
  },
  {
    src: '/images/herobg-3.jpg',
    alt: 'Student smiling behind a camera on a tripod while shooting outdoors',
    w: 2048,
    h: 1365,
    pos: '48% 50%',
  },
];

const intro =
  'InFocus Film School’s courses are project-based, accessible, and meticulously designed to build the skills and knowledge needed for Canada’s entertainment economy. Your future in film and cinematic arts awaits.';
---

<section class="hero">
  <div class="hero__grid">
    {
      panels.map((p) => (
        <figure class="hero__panel">
          <img
            src={p.src}
            alt={p.alt}
            width={p.w}
            height={p.h}
            style={`object-position: ${p.pos}`}
            loading="eager"
            decoding="async"
          />
        </figure>
      ))
    }
  </div>

  <div class="hero__bottom">
    <h1 class="hero__title">
      <span class="line reveal">Your <em>future</em></span>
      <span class="line reveal">in focus</span>
    </h1>

    <div class="hero__aside">
      <p class="hero__intro reveal">{intro}</p>
      <a class="hero__cta reveal" href="/programs">Explore Programs</a>
    </div>
  </div>
</section>

<style>
  /* ---- Load sequence -------------------------------------------------
     Panels wipe up while the photo settles out of a slight push-in, then
     the headline lines and the aside rise in behind them. Pure CSS, so it
     runs without JS; `both` fill-mode holds the from-state through the
     delay, otherwise staggered items flash in place first. */

  @keyframes panel-wipe {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes panel-settle {
    from {
      transform: scale(1.14);
    }
    to {
      transform: scale(1);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.42em);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero__panel {
    animation: panel-wipe 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero__panel img {
    animation: panel-settle 1.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero__panel:nth-child(1),
  .hero__panel:nth-child(1) img {
    animation-delay: 0.15s;
  }

  .hero__panel:nth-child(2),
  .hero__panel:nth-child(2) img {
    animation-delay: 0.28s;
  }

  .hero__panel:nth-child(3),
  .hero__panel:nth-child(3) img {
    animation-delay: 0.41s;
  }

  .reveal {
    animation: rise 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero__title .line:nth-child(1) {
    animation-delay: 0.62s;
  }

  .hero__title .line:nth-child(2) {
    animation-delay: 0.73s;
  }

  .hero__intro {
    animation-delay: 0.88s;
  }

  .hero__cta {
    animation-delay: 0.99s;
  }

  /* Skip the sequence outright rather than racing it to zero. */
  @media (prefers-reduced-motion: reduce) {
    .hero__panel,
    .hero__panel img,
    .reveal {
      animation: none;
    }

    .hero__cta:hover {
      transform: none;
    }
  }

  .hero {
    padding: 0 var(--gutter) clamp(28px, 3.5vw, 56px);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
  }

  .hero__panel {
    margin: 0;
    overflow: hidden;
  }

  .hero__panel img {
    width: 100%;
    height: auto;
    aspect-ratio: 529 / 657;
    object-fit: cover;
  }

  .hero__bottom {
    display: grid;
    grid-template-columns: 1fr minmax(0, 34.5%);
    gap: clamp(24px, 2.6vw, 44px);
    align-items: start;
    margin-top: clamp(20px, 2.4vw, 40px);
  }

  /* Oswald is condensed, so it carries a larger size than the previous
     grotesk at the same column width. */
  .hero__title {
    margin: 0;
    font-size: clamp(44px, 8.2vw, 146px);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: 0.004em;
  }

  .hero__title .line {
    display: block;
  }

  /* Serif italic accent against the condensed caps — the reference's move.
     Oswald's caps sit tall in the em, so the italic is sized up to match. */
  .hero__title em {
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 500;
    font-variation-settings: 'opsz' 96, 'wght' 500;
    font-size: 1.16em;
    letter-spacing: 0.005em;
  }

  .hero__aside {
    /* Nudges the paragraph onto the headline's first-line baseline. */
    padding-top: clamp(4px, 0.7vw, 12px);
  }

  .hero__intro {
    margin: 0;
    color: var(--fg-muted);
    font-size: clamp(15px, 1.18vw, 20px);
    font-weight: 400;
    line-height: 1.42;
  }

  .hero__cta {
    display: inline-grid;
    place-items: center;
    min-width: clamp(200px, 17.5vw, 292px);
    padding: clamp(16px, 1.6vw, 25px) clamp(20px, 2vw, 34px);
    margin-top: clamp(18px, 2.2vw, 37px);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-size: clamp(11px, 0.85vw, 14px);
    font-weight: 700;
    letter-spacing: 0.075em;
    text-transform: uppercase;
    transition:
      background-color 0.34s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.34s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.34s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero__cta:hover {
    background: var(--red);
    color: var(--white);
    transform: translateY(-2px);
  }

  @media (max-width: 860px) {
    .hero__bottom {
      grid-template-columns: 1fr;
      gap: 26px;
    }

    .hero__title {
      font-size: clamp(42px, 12vw, 88px);
    }

    .hero__cta {
      width: 100%;
    }
  }

  @media (max-width: 560px) {
    .hero__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Third panel spans the full width beneath the pair. */
    .hero__panel:last-child {
      grid-column: 1 / -1;
    }

    .hero__panel:last-child img {
      aspect-ratio: 16 / 10;
    }
  }
</style>
